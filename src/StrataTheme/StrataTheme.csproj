<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet metadata -->
    <PackageId>StrataUI.Theme</PackageId>
    <Version>0.3.81</Version>
    <Authors>StrataUI</Authors>
    <Description>A modern, token-driven Avalonia theme for professional desktop applications.</Description>
    <PackageTags>avalonia;theme;ui;desktop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StrataDemo" />
    <InternalsVisibleTo Include="StrataBenchmark" />
    <InternalsVisibleTo Include="StrataTheme.Tests" />
    <InternalsVisibleTo Include="Lumi" />
    <InternalsVisibleTo Include="Lumi.Tests" />
    <InternalsVisibleTo Include="Lumi.Mobile.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="[$(AvaloniaDataGridVersion)]" />
    <!-- StrataBackdropBlur samples and frosts the Skia drawing surface. -->
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="TextMateSharp.Grammars" Version="1.0.65" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
  </ItemGroup>

  <ItemGroup>
    <!-- The self-contained diff UserControl is already included by Avalonia's default XAML items. -->
    <AvaloniaResource Include="**\*.axaml" Exclude="Controls\StrataDiffView.axaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataSearch\StrataSearch.csproj" />
  </ItemGroup>

</Project>
