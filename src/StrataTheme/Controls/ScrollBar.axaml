<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">

  <!-- ═══════════════════════════════════════════════════════════
       STRATA UI – ScrollBar + ScrollViewer
       At rest a scrollbar is only its thumb, a slim pill. With the
       pointer on the bar its track, a hairline, fades in and the
       thumb widens and brightens; dragging lights the thumb in the
       accent. StrataTranscriptRail rests and opens the same way.
       ═══════════════════════════════════════════════════════════ -->

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
    <Setter Property="Margin" Value="0,4,4,4" />
  </Style>

  <Style Selector="ScrollViewer /template/ ScrollBar#PART_HorizontalScrollBar">
    <Setter Property="Margin" Value="4,0,4,4" />
  </Style>

  <Style Selector="ScrollViewer /template/ Panel">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- The whole bar takes the pointer; the track line under the thumb shows only while it does. -->
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="1,0,1,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}" UseLayoutRounding="False">
          <Border Name="PART_TrackLine" Width="2" HorizontalAlignment="Center" />
          <Track IsDirectionReversed="True"
                 Maximum="{TemplateBinding Maximum}"
                 Minimum="{TemplateBinding Minimum}"
                 Orientation="{TemplateBinding Orientation}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                 Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton"
                            Classes="repeattrack"
                            Focusable="False"
                            AutomationProperties.Name="{controls:InteractiveLabel scrollPageUp}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton"
                            Classes="repeattrack"
                            Focusable="False"
                            AutomationProperties.Name="{controls:InteractiveLabel scrollPageDown}" />
            </Track.IncreaseButton>
            <Thumb Name="thumb" AutomationProperties.Name="{controls:InteractiveLabel scrollPosition}" />
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="8" />
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}" UseLayoutRounding="False">
          <Border Name="PART_TrackLine" Height="2" VerticalAlignment="Center" />
          <Track Maximum="{TemplateBinding Maximum}"
                 Minimum="{TemplateBinding Minimum}"
                 Orientation="{TemplateBinding Orientation}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                 Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton"
                            Classes="repeattrack"
                            Focusable="False"
                            AutomationProperties.Name="{controls:InteractiveLabel scrollPageLeft}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton"
                            Classes="repeattrack"
                            Focusable="False"
                            AutomationProperties.Name="{controls:InteractiveLabel scrollPageRight}" />
            </Track.IncreaseButton>
            <Thumb Name="thumb" AutomationProperties.Name="{controls:InteractiveLabel scrollPosition}" />
          </Track>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ScrollBar /template/ Border#PART_TrackLine">
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Border#PART_TrackLine">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Page buttons only take clicks: whatever hover background they get stays unseen. -->
  <Style Selector="ScrollBar /template/ RepeatButton.repeattrack">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ScrollBar /template/ Thumb#thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.ScrollbarThumb}" />
    <!-- Track's drag correction uses Thumb.Bounds; inset the paint (Padding), not the thumb. -->
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Radius.Full}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A 4px pill at rest; 6px while the pointer is on the bar or holds the thumb. -->
  <Style Selector="ScrollBar:vertical /template/ Thumb#thumb">
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="ScrollBar:horizontal /template/ Thumb#thumb">
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb#thumb, ScrollBar:vertical /template/ Thumb#thumb:pressed">
    <Setter Property="Padding" Value="1,0" />
  </Style>
  <Style Selector="ScrollBar:horizontal:pointerover /template/ Thumb#thumb, ScrollBar:horizontal /template/ Thumb#thumb:pressed">
    <Setter Property="Padding" Value="0,1" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb#thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.ScrollbarThumbHover}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb#thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>

  <!-- ── scroll-fade: auto-hide scrollbars until the ScrollViewer is hovered ── -->
  <Style Selector="ScrollViewer.scroll-fade /template/ ScrollBar">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ScrollViewer.scroll-fade:pointerover /template/ ScrollBar">
    <Setter Property="Opacity" Value="1" />
  </Style>

</Styles>
