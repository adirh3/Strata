<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataMermaid}" TargetType="controls:StrataMermaid">
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
          <ControlTemplate>
            <!-- Borderless: the diagram sits straight on the transcript. -->
            <Border ClipToBounds="True">
              <Grid RowDefinitions="*,Auto" ClipToBounds="True">
                <Panel Name="PART_DiagramHost" Background="Transparent" />

                <Border Name="PART_CodeHost"
                        IsVisible="False"
                        CornerRadius="10"
                        BorderThickness="{DynamicResource Stroke.Thin}"
                        Background="{DynamicResource Brush.GlassWell}"
                        BorderBrush="{DynamicResource Brush.GlassDivider}">
                  <ScrollViewer MaxHeight="480"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Name="PART_CodeText"
                                         Margin="14,12"
                                         Text="{TemplateBinding Source}"
                                         FontFamily="{DynamicResource Font.FamilyMono}"
                                         FontSize="12.5"
                                         LineHeight="19"
                                         Foreground="{DynamicResource Brush.TextPrimary}" />
                  </ScrollViewer>
                </Border>

                <!-- How to look at the diagram. Where it is narrow, as in a card or a comparison on a phone,
                     the pills wrap rather than be cut off. -->
                <Border Name="PART_ZoomBar" Grid.Row="1"
                        Background="Transparent" Padding="0,6,0,0">
                  <WrapPanel ItemsAlignment="End"
                             ItemSpacing="6"
                             LineSpacing="6">
                    <!-- Each pill is its row of buttons over a pane of glass that rises only when reached for. -->
                    <Border Name="PART_ViewSwitch" Classes="mermaid-pill">
                      <Panel>
                        <Border Classes="mermaid-glass" />
                        <StackPanel Classes="mermaid-row" Orientation="Horizontal">
                          <Button Name="PART_DiagramView" Classes="mermaid-segment"
                                  Content="{controls:InteractiveLabel diagram}" />
                          <Button Name="PART_SourceView" Classes="mermaid-segment"
                                  Content="{controls:InteractiveLabel diagramCode}" />
                        </StackPanel>
                      </Panel>
                    </Border>

                    <Border Name="PART_ZoomGroup" Classes="mermaid-pill">
                      <Panel>
                        <Border Classes="mermaid-glass" />
                        <StackPanel Classes="mermaid-row" Orientation="Horizontal">
                          <Button Name="PART_ZoomOut" Classes="mermaid-tool"
                                  ToolTip.Tip="{controls:InteractiveLabel zoomOutShortcut}" AutomationProperties.Name="{controls:InteractiveLabel zoomOut}">
                            <controls:StrataLineIcon Data="{x:Static controls:StrataIcons.Minus}" />
                          </Button>
                          <Button Name="PART_ActualSize" Classes="mermaid-tool" MinWidth="46"
                                  ToolTip.Tip="{controls:InteractiveLabel actualSizeTip}" AutomationProperties.Name="{controls:InteractiveLabel actualSize}">
                            <!-- In its button's ink, which the theme's own TextBlock colour would otherwise outrank. -->
                            <TextBlock Name="PART_ZoomLabel" Text="100%" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{Binding $parent[Button].Foreground}" />
                          </Button>
                          <Button Name="PART_ZoomIn" Classes="mermaid-tool"
                                  ToolTip.Tip="{controls:InteractiveLabel zoomInShortcut}" AutomationProperties.Name="{controls:InteractiveLabel zoomIn}">
                            <controls:StrataLineIcon Data="{x:Static controls:StrataIcons.Plus}" />
                          </Button>
                          <Button Name="PART_ZoomReset" Classes="mermaid-tool"
                                  ToolTip.Tip="{controls:InteractiveLabel fitDiagramShortcut}" AutomationProperties.Name="{controls:InteractiveLabel fitDiagram}">
                            <controls:StrataLineIcon Data="{x:Static controls:StrataIcons.FitView}" />
                          </Button>
                        </StackPanel>
                      </Panel>
                    </Border>

                    <Border Name="PART_ToolPill" Classes="mermaid-pill">
                      <Panel>
                        <Border Classes="mermaid-glass" />
                        <StackPanel Classes="mermaid-row" Orientation="Horizontal">
                          <Button Name="PART_CopySource" Classes="mermaid-tool"
                                  ToolTip.Tip="{controls:InteractiveLabel copy}" AutomationProperties.Name="{controls:InteractiveLabel copy}">
                            <controls:StrataLineIcon Name="PART_CopyIcon" Data="{x:Static controls:StrataIcons.Copy}" />
                          </Button>
                          <Button Name="PART_Expand" Classes="mermaid-tool"
                                  ToolTip.Tip="{controls:InteractiveLabel fullScreen}" AutomationProperties.Name="{controls:InteractiveLabel fullScreen}">
                            <controls:StrataLineIcon Name="PART_ExpandIcon" Data="{x:Static controls:StrataIcons.Expand}" />
                          </Button>
                        </StackPanel>
                      </Panel>
                    </Border>
                  </WrapPanel>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>

        <!-- ─── Toolbar: quiet ink at rest, glass pills when reached for ─── -->
        <!-- At rest the toolbar is its icons and words alone, so the diagram reads as part of the message. A mouse
             resting on the diagram or keyboard focus inside it (:engaged), or full screen, raises each pill's glass.
             Only paint changes, so nothing moves. -->
        <Style Selector="^ /template/ Border.mermaid-glass">
          <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
          <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Thin}" />
          <Setter Property="CornerRadius" Value="999" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:engaged /template/ Border.mermaid-glass, ^:fullscreen /template/ Border.mermaid-glass">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Inside the glass's rim, as a pill's padding. -->
        <Style Selector="^ /template/ StackPanel.mermaid-row">
          <Setter Property="Margin" Value="3" />
        </Style>
        <!-- The button's whole box takes touches; what shows is its surface, which a host may inset so a touch
             target larger than the pill keeps its lit and pressed states inside the pill. -->
        <Style Selector="^ /template/ Button.mermaid-tool, ^ /template/ Button.mermaid-segment">
          <Setter Property="Height" Value="26" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="7,0" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
          <Setter Property="Template">
            <ControlTemplate TargetType="Button">
              <Panel Background="Transparent">
                <Border Name="PART_Surface"
                        Background="{TemplateBinding Background}"
                        CornerRadius="999"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
              </Panel>
            </ControlTemplate>
          </Setter>
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Foreground" Duration="0:0:0.12" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Button.mermaid-tool controls|StrataLineIcon">
          <Setter Property="Width" Value="14" />
          <Setter Property="Height" Value="14" />
          <Setter Property="StrokeThickness" Value="1.8" />
        </Style>
        <!-- Text set here, not presented: the theme's TextBlock style would outrank inherited colour and size.
             The chosen view's capsule is its own layer, so it can fade in with the glass. Keyboard focus rings the
             segment in the focus colour, which the capsule never matches, not even in high contrast. -->
        <Style Selector="^ /template/ Button.mermaid-segment">
          <Setter Property="Padding" Value="10,0" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Template">
            <ControlTemplate TargetType="Button">
              <Panel Background="Transparent">
                <Border Name="PART_Capsule"
                        CornerRadius="999"
                        Background="{DynamicResource Brush.GlassRimHover}"
                        Opacity="0"
                        IsHitTestVisible="False">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
                <Border Name="PART_Surface"
                        Background="{TemplateBinding Background}"
                        CornerRadius="999"
                        Padding="{TemplateBinding Padding}">
                  <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{TemplateBinding FontSize}"
                             FontWeight="{TemplateBinding FontWeight}"
                             HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <Border Name="PART_SegmentFocus"
                        CornerRadius="999"
                        BorderThickness="{DynamicResource Stroke.FocusRing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        IsHitTestVisible="False" />
              </Panel>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="^ /template/ Button.mermaid-tool:pointerover, ^ /template/ Button.mermaid-segment:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
          <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
        </Style>
        <Style Selector="^ /template/ Button.mermaid-tool:pressed, ^ /template/ Button.mermaid-segment:pressed">
          <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
        </Style>
        <Style Selector="^ /template/ Button.mermaid-tool:focus-visible, ^ /template/ Button.mermaid-segment:focus-visible">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
          <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
        </Style>
        <Style Selector="^ /template/ Button.mermaid-segment:focus-visible">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFocus}" />
        </Style>
        <Style Selector="^ /template/ Button.mermaid-tool.copied">
          <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
        </Style>

        <!-- The view being shown reads a shade brighter at rest, and wears its capsule once the toolbar is raised (the
             capsule is lit by the styles after this theme, which can reach into the segment's own template). -->
        <Style Selector="^:not(:code) /template/ Button#PART_DiagramView, ^:code /template/ Button#PART_SourceView">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="^:engaged:not(:code) /template/ Button#PART_DiagramView, ^:engaged:code /template/ Button#PART_SourceView">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <!-- ─── Code: the source in place of the drawing ─── -->
        <Style Selector="^:code /template/ Panel#PART_DiagramHost">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:code /template/ Border#PART_CodeHost">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:code /template/ Border#PART_ZoomGroup">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Full screen has its own close button and no use for the code view. -->
        <Style Selector="^:fullscreen /template/ Border#PART_ViewSwitch">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The chosen view's capsule, inside its segment's template, fades in with the toolbar's glass. -->
  <Style Selector="controls|StrataMermaid:engaged:not(:code) /template/ Button#PART_DiagramView /template/ Border#PART_Capsule,
                   controls|StrataMermaid:engaged:code /template/ Button#PART_SourceView /template/ Border#PART_Capsule">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
