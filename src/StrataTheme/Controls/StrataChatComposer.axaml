<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls"
        xmlns:textInput="using:Avalonia.Input.TextInput"
        xmlns:strata="using:StrataTheme">

  <!-- ═══════════════════════════════════════════════════════════════
       StrataChatComposer
       A soft, rounded card: what the message carries (agent, project,
       skills, other chats) as chips on top, a borderless text area,
       then one row of quiet tools — + (files, chats, agents and the rest),
       Skills, Connectors, the model — then a microphone that dictates
       and one round button that sends and stops.
       The glass class turns the card translucent over a frosted backdrop.
       ═══════════════════════════════════════════════════════════════ -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Glass: the overlay surface at two thirds over its own frost, the same recipe as the other glass
               that floats over content, so the composer reads as one material with it rather than a grey panel. -->
          <SolidColorBrush x:Key="Brush.ComposerGlassFill" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.66" />
          <SolidColorBrush x:Key="Brush.ComposerGlassBorder" Color="{DynamicResource Color.TextPrimary}" Opacity="0.1" />
          <SolidColorBrush x:Key="Brush.ComposerGlassBorderHover" Color="{DynamicResource Color.TextPrimary}" Opacity="0.16" />
          <SolidColorBrush x:Key="Brush.ComposerFocusBorder" Color="{DynamicResource Color.AccentDefault}" Opacity="0.5" />
          <BoxShadows x:Key="Shadow.ComposerRest">0 10 28 -14 #3D101828, 0 2 6 -2 #12101828</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerHover">0 14 34 -14 #4D101828, 0 2 8 -2 #18101828</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerFocus">0 0 0 4 #174F46E5, 0 14 34 -14 #4D101828, 0 2 8 -2 #18101828</BoxShadows>
          <!-- Context chips: a neutral pill; each kind's hue only tints its small tile. -->
          <SolidColorBrush x:Key="Brush.ComposerChipFill" Color="#0A000000" />
          <SolidColorBrush x:Key="Brush.ComposerChipBorder" Color="#12000000" />
          <SolidColorBrush x:Key="Brush.ComposerAgentHue" Color="#5E50B5" />
          <SolidColorBrush x:Key="Brush.ComposerAgentTile" Color="#1F5E50B5" />
          <SolidColorBrush x:Key="Brush.ComposerProjectHue" Color="#3D6F99" />
          <SolidColorBrush x:Key="Brush.ComposerProjectTile" Color="#1F3D6F99" />
          <SolidColorBrush x:Key="Brush.ComposerSkillTile" Color="#1F8F6A22" />
          <SolidColorBrush x:Key="Brush.ComposerSkillHue" Color="#8F6A22" />
          <SolidColorBrush x:Key="Brush.ComposerChatTile" Color="#1F4F46E5" />
          <!-- Glass at rest, and in focus: it comes forward, so its shadow deepens and its top edge catches the
               light. Both have the same layers, so one blends into the other. -->
          <BoxShadows x:Key="Shadow.ComposerGlassRest">0 10 28 -14 #3D101828, 0 2 6 -2 #12101828, inset 0 1 0 0 #00FFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerGlassFocus">0 18 40 -16 #4D101828, 0 3 10 -3 #18101828, inset 0 1 0 0 #FFFFFFFF</BoxShadows>
          <!-- The round send button: Lumi's gradient when there is something to send. -->
          <LinearGradientBrush x:Key="Brush.ComposerOrbReady" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#6366F1" />
            <GradientStop Offset="0.55" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#EC4899" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="Brush.ComposerOrbReadyHover" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#7477F4" />
            <GradientStop Offset="0.55" Color="#9A6DF8" />
            <GradientStop Offset="1" Color="#F05BA6" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="Brush.ComposerOrbIdle" Color="#0F000000" />
          <SolidColorBrush x:Key="Brush.ComposerOrbWorking" Color="{DynamicResource Color.Surface2}" />
          <SolidColorBrush x:Key="Brush.ComposerOrbWorkingHover" Color="{DynamicResource Color.ControlPressed}" />
          <SolidColorBrush x:Key="Brush.ComposerOrbWorkingForeground" Color="{DynamicResource Color.TextPrimary}" />
          <LinearGradientBrush x:Key="Brush.ComposerOrbListening" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#EC4899" />
          </LinearGradientBrush>
          <ConicGradientBrush x:Key="Brush.ComposerOrbRing" Center="50%,50%" Angle="0">
            <GradientStop Offset="0" Color="#006366F1" />
            <GradientStop Offset="0.3" Color="#6366F1" />
            <GradientStop Offset="0.62" Color="#8B5CF6" />
            <GradientStop Offset="0.88" Color="#EC4899" />
            <GradientStop Offset="1" Color="#00EC4899" />
          </ConicGradientBrush>
          <BoxShadows x:Key="Shadow.ComposerOrbReady">0 6 14 -6 #A68B5CF6</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerOrbListening">0 0 0 4 #29EC4899</BoxShadows>
          <!-- Dictation: the voice bar's pulse and waveform share the listening orb's warmth. -->
          <SolidColorBrush x:Key="Brush.ComposerVoicePulse" Color="#EC4899" />
          <LinearGradientBrush x:Key="Brush.ComposerVoiceWave" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#6366F1" />
            <GradientStop Offset="0.6" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#EC4899" />
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <!-- The same glass as in light: a shade above the surface it floats on, never a grey cast over it. -->
          <SolidColorBrush x:Key="Brush.ComposerGlassFill" Color="{DynamicResource Color.SurfaceOverlay}" Opacity="0.66" />
          <SolidColorBrush x:Key="Brush.ComposerGlassBorder" Color="{DynamicResource Color.TextPrimary}" Opacity="0.1" />
          <SolidColorBrush x:Key="Brush.ComposerGlassBorderHover" Color="{DynamicResource Color.TextPrimary}" Opacity="0.16" />
          <SolidColorBrush x:Key="Brush.ComposerFocusBorder" Color="{DynamicResource Color.AccentDefault}" Opacity="0.55" />
          <BoxShadows x:Key="Shadow.ComposerRest">0 14 34 -14 #73000000, 0 2 8 -2 #33000000, inset 0 1 0 0 #0FFFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerHover">0 16 38 -14 #85000000, 0 2 8 -2 #38000000, inset 0 1 0 0 #14FFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerFocus">0 0 0 4 #22818CF8, 0 16 38 -14 #85000000, 0 2 8 -2 #38000000, inset 0 1 0 0 #14FFFFFF</BoxShadows>
          <SolidColorBrush x:Key="Brush.ComposerChipFill" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="Brush.ComposerChipBorder" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="Brush.ComposerAgentHue" Color="#A59BDD" />
          <SolidColorBrush x:Key="Brush.ComposerAgentTile" Color="#2EA59BDD" />
          <SolidColorBrush x:Key="Brush.ComposerProjectHue" Color="#8FB4D4" />
          <SolidColorBrush x:Key="Brush.ComposerProjectTile" Color="#2E8FB4D4" />
          <SolidColorBrush x:Key="Brush.ComposerSkillTile" Color="#2ECDAE70" />
          <SolidColorBrush x:Key="Brush.ComposerSkillHue" Color="#DCC089" />
          <SolidColorBrush x:Key="Brush.ComposerChatTile" Color="#33818CF8" />
          <BoxShadows x:Key="Shadow.ComposerGlassRest">0 14 34 -14 #73000000, 0 2 8 -2 #33000000, inset 0 1 0 0 #0FFFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerGlassFocus">0 22 46 -16 #94000000, 0 4 12 -4 #40000000, inset 0 1 0 0 #24C7CDFE</BoxShadows>
          <LinearGradientBrush x:Key="Brush.ComposerOrbReady" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#818CF8" />
            <GradientStop Offset="0.55" Color="#A78BFA" />
            <GradientStop Offset="1" Color="#F472B6" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="Brush.ComposerOrbReadyHover" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#97A0FA" />
            <GradientStop Offset="0.55" Color="#B89FFB" />
            <GradientStop Offset="1" Color="#F78AC4" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="Brush.ComposerOrbIdle" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="Brush.ComposerOrbWorking" Color="#1C1C24" />
          <SolidColorBrush x:Key="Brush.ComposerOrbWorkingHover" Color="#2A2A34" />
          <SolidColorBrush x:Key="Brush.ComposerOrbWorkingForeground" Color="{DynamicResource Color.TextOnAccent}" />
          <LinearGradientBrush x:Key="Brush.ComposerOrbListening" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#A78BFA" />
            <GradientStop Offset="1" Color="#F472B6" />
          </LinearGradientBrush>
          <ConicGradientBrush x:Key="Brush.ComposerOrbRing" Center="50%,50%" Angle="0">
            <GradientStop Offset="0" Color="#00818CF8" />
            <GradientStop Offset="0.3" Color="#818CF8" />
            <GradientStop Offset="0.62" Color="#A78BFA" />
            <GradientStop Offset="0.88" Color="#F472B6" />
            <GradientStop Offset="1" Color="#00F472B6" />
          </ConicGradientBrush>
          <BoxShadows x:Key="Shadow.ComposerOrbReady">0 6 16 -6 #D9A78BFA, inset 0 1 0 0 #59FFFFFF</BoxShadows>
          <BoxShadows x:Key="Shadow.ComposerOrbListening">0 0 0 4 #33F472B6</BoxShadows>
          <SolidColorBrush x:Key="Brush.ComposerVoicePulse" Color="#F472B6" />
          <LinearGradientBrush x:Key="Brush.ComposerVoiceWave" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#818CF8" />
            <GradientStop Offset="0.6" Color="#A78BFA" />
            <GradientStop Offset="1" Color="#F472B6" />
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="Composer.Icon.Remove">M6.4 6.4a1 1 0 0 1 1.4 0L12 10.6l4.2-4.2a1 1 0 1 1 1.4 1.4L13.4 12l4.2 4.2a1 1 0 1 1-1.4 1.4L12 13.4l-4.2 4.2a1 1 0 0 1-1.4-1.4L10.6 12 6.4 7.8a1 1 0 0 1 0-1.4z</StreamGeometry>

      <ControlTheme x:Key="{x:Type controls:StrataChatComposer}" TargetType="controls:StrataChatComposer">
        <!-- The card's shadow falls outside it: a templated control would otherwise clip it to a square. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
            <!-- Frost behind a translucent surface; the glass class turns it on. -->
            <controls:StrataBackdropBlur Name="PART_Backdrop"
                                         IsVisible="False"
                                         CornerRadius="{Binding CornerRadius, ElementName=PART_Root}" />
            <Border Name="PART_Root"
                    Background="{DynamicResource Brush.Surface0}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="0"
                    BoxShadow="{DynamicResource Shadow.ComposerRest}">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                  <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.24" />
                </Transitions>
              </Border.Transitions>

              <StackPanel>

                <!-- What the message carries: agent, project, skills and other chats -->
                <ScrollViewer Name="PART_ContextScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              IsScrollChainingEnabled="False">
                <WrapPanel Name="PART_ChipsRow"
                           Orientation="Horizontal"
                           Margin="12,12,12,0">
                  <!-- Agent chip (hidden via :has-agent pseudo-class) -->
                  <Border Name="PART_AgentChip"
                          Classes="composer-chip"
                          Margin="0,0,6,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <Border Name="PART_AgentChipSurface" Grid.ColumnSpan="3"
                              IsVisible="False" IsHitTestVisible="False" />
                      <Border Name="PART_AgentTile" Classes="chip-tile" VerticalAlignment="Center">
                        <TextBlock Name="PART_AgentGlyph" Text="{TemplateBinding AgentGlyph}"
                                   FontSize="{DynamicResource Font.SizeCaption}"
                                   Foreground="{DynamicResource Brush.ComposerAgentHue}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Name="PART_AgentName" Grid.Column="1" Text="{TemplateBinding AgentName}"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Button Name="PART_AgentRemoveButton" Grid.Column="2"
                              Classes="subtle chip-remove"
                              AutomationProperties.Name="Remove agent"
                              VerticalAlignment="Center"
                              Cursor="Hand">
                        <TextBlock Name="PART_AgentRemoveGlyph" Text="×"
                                   Classes="chip-remove-icon" />
                      </Button>
                    </Grid>
                  </Border>
                  <!-- Project chip (hidden via :has-project pseudo-class) -->
                  <Border Name="PART_ProjectChip"
                          Classes="composer-chip"
                          Margin="0,0,6,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <Border Name="PART_ProjectChipSurface" Grid.ColumnSpan="3"
                              IsVisible="False" IsHitTestVisible="False" />
                      <Border Name="PART_ProjectTile" Classes="chip-tile" VerticalAlignment="Center">
                        <controls:StrataLineIcon Name="PART_ProjectIcon" Width="12" Height="12"
                                                 StrokeThickness="2.1"
                                                 Foreground="{DynamicResource Brush.ComposerProjectHue}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Data="{x:Static controls:StrataIcons.Folder}" />
                      </Border>
                      <TextBlock Name="PART_ProjectName" Grid.Column="1" Text="{TemplateBinding ProjectName}"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <Button Name="PART_ProjectRemoveButton" Grid.Column="2"
                              Classes="subtle chip-remove"
                              AutomationProperties.Name="Remove project"
                              VerticalAlignment="Center"
                              Cursor="Hand">
                        <PathIcon Width="8" Height="8" Foreground="{DynamicResource Brush.TextTertiary}"
                                  Data="{StaticResource Composer.Icon.Remove}" />
                      </Button>
                    </Grid>
                  </Border>
                  <!-- Skill and chat chips are appended here programmatically -->
                </WrapPanel>
                </ScrollViewer>

                <!-- Inline attachment chips (above the text input) -->
                <ContentPresenter Name="PART_AttachmentContent"
                                  Content="{TemplateBinding AttachmentContent}"
                                  Margin="10,6,10,0" />

                <controls:ComposerLayoutPanel Name="PART_ComposerLayout">
                <StackPanel Name="PART_EditorArea">
                <!-- Text input -->
                <Panel Name="PART_InputPanel">
                  <StackPanel Name="PART_InputStack">
                  <TextBox Name="PART_Input"
                           Classes="composer-embed"
                           Text="{Binding PromptText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           PlaceholderText="{TemplateBinding Placeholder}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="48" MaxHeight="200"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="18,18,18,8"
                           VerticalContentAlignment="Top"
                           FontSize="{DynamicResource Font.SizeBody}"
                           CornerRadius="0"
                           MinWidth="0" />
                  <!-- Dictation: the words heard so far, in quiet text under the text already there. -->
                  <controls:ComposerTailPanel Name="PART_VoicePreviewHost"
                                              IsVisible="False"
                                              MaxHeight="44"
                                              Margin="18,0,18,10">
                    <TextBlock Name="PART_VoicePreview"
                               Text="{TemplateBinding VoicePreview}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource Font.SizeBody}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                  </controls:ComposerTailPanel>
                  </StackPanel>
                  <!-- Dictation into an empty prompt: the words heard so far sit where they will land. -->
                  <controls:ComposerTailPanel Name="PART_VoicePreviewInlineHost"
                                              IsVisible="False"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Top"
                                              MaxHeight="44"
                                              Margin="18,18,18,8">
                    <TextBlock Name="PART_VoicePreviewInline"
                               Text="{TemplateBinding VoicePreview}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource Font.SizeBody}"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                  </controls:ComposerTailPanel>
                  <ContentPresenter Name="PART_EditorContent"
                                    Content="{TemplateBinding EditorContent}"
                                    IsVisible="False"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />

                  <Border Name="PART_FocusLine"
                          Height="2"
                          Margin="18,0"
                          VerticalAlignment="Bottom"
                          CornerRadius="1"
                          Background="{DynamicResource Brush.StratumLine}"
                          ClipToBounds="True"
                          Opacity="0"
                          RenderTransformOrigin="0%,50%"
                          RenderTransform="scaleX(0)"
                          IsHitTestVisible="False">
                    <Border.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut" />
                      </Transitions>
                    </Border.Transitions>
                    <Border Name="PART_FocusSweep"
                            Width="160"
                            HorizontalAlignment="Left"
                            Opacity="0"
                            IsVisible="False">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                          <GradientStop Offset="0" Color="#00FFFFFF" />
                          <GradientStop Offset="0.5" Color="{DynamicResource Color.TextOnAccent}" />
                          <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                  </Border>

                  <!-- Inline autocomplete (/ skills, @ agents, $ projects, # chats and files). In the
                       window's overlay layer, so its glass frosts the chat beneath it. -->
                  <Popup Name="PART_AutoCompletePopup"
                         IsLightDismissEnabled="True"
                         OverlayDismissEventPassThrough="True"
                         ShouldUseOverlayLayer="True"
                         Placement="AnchorAndGravity"
                         PlacementAnchor="BottomLeft"
                         PlacementGravity="BottomRight"
                         WindowManagerAddShadowHint="False"
                         strata:PopupAnimationHelper.EnableOpenAnimation="False"
                         strata:PopupAnimationHelper.EnableOverlayAnimation="True"
                         strata:PopupAnimationHelper.OpenAnimationDuration="0:0:0.12">
                    <Panel MinWidth="280" MaxWidth="560" TextOptions.TextRenderingMode="Antialias">
                      <Border CornerRadius="14" ClipToBounds="True" IsHitTestVisible="False">
                        <controls:StrataBackdropBlur CornerRadius="14" BlurRadius="22" Saturation="1.4" />
                      </Border>
                      <Border Background="{DynamicResource Brush.Surface1Glass}"
                              BorderBrush="{DynamicResource Brush.BorderDefault}"
                              BorderThickness="1"
                              CornerRadius="14"
                              Padding="6"
                              BoxShadow="0 18 44 -10 #48000000, 0 4 14 0 #22000000">
                        <ScrollViewer Name="PART_AutoCompleteScrollViewer"
                                      MaxHeight="340"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                          <StackPanel Name="PART_AutoCompletePanel" Spacing="1" />
                        </ScrollViewer>
                      </Border>
                    </Panel>
                  </Popup>
                </Panel>

                <!-- Optional status content (e.g. coding toolbar) -->
                <ContentPresenter Name="PART_StatusContent"
                                  Content="{TemplateBinding StatusContent}"
                                  IsVisible="{TemplateBinding StatusContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  Margin="12,2,12,0" />
                </StackPanel>

                <!-- Toolbar row -->
                <Grid Name="PART_Toolbar" Margin="10,10,10,10" ColumnDefinitions="Auto,*,Auto">
                  <ContentPresenter Name="PART_LeadingContent" Grid.Column="0"
                                    Content="{TemplateBinding LeadingContent}"
                                    IsVisible="{TemplateBinding LeadingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    VerticalAlignment="Bottom" />

                  <!-- Left: attach, what to bring in, then how to answer (wraps to stay responsive); while dictating,
                       the voice bar (after the primary actions) takes their place. -->
                  <WrapPanel Name="PART_SecondaryActions" Grid.Column="1"
                             Orientation="Horizontal"
                             Margin="0,0,8,0"
                             VerticalAlignment="Bottom">

                    <!-- Host-supplied toolbar content, first in the row. -->
                    <ContentPresenter Name="PART_ToolbarContent"
                                      Content="{TemplateBinding ToolbarContent}"
                                      VerticalAlignment="Center" />

                    <!-- Add: everything a message can bring in, in one menu. -->
                    <Panel Name="PART_AddWrap" Margin="0,0,4,6" VerticalAlignment="Center">
                      <Button Name="PART_AddButton"
                              Classes="composer-tool"
                              Width="32" Height="32"
                              Padding="0"
                              CornerRadius="16"
                              VerticalAlignment="Center"
                              ToolTip.Tip="{TemplateBinding AddButtonToolTip}"
                              AutomationProperties.Name="{TemplateBinding AddButtonToolTip}">
                        <controls:StrataLineIcon Width="18" Height="18"
                                                 StrokeThickness="1.9"
                                                 Data="{x:Static controls:StrataIcons.Plus}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>

                      <!-- Other chats: no pill of its own, the + menu opens their list. -->
                      <controls:StrataComposerPicker Name="PART_ChatPicker"
                                                     Classes="chats add-list"
                                                     CloseOnSelect="True"
                                                     MaxListedItems="60"
                                                     PlacementTarget="{Binding #PART_AddButton}"
                                                     Icon="{x:Static controls:StrataIcons.Chats}"
                                                     ItemIcon="{x:Static controls:StrataIcons.Chat}"
                                                     Items="{TemplateBinding AvailableChats}"
                                                     SelectedItems="{TemplateBinding ChatItems}" />

                      <!-- Agents: also no pill, the + menu opens their list. One answers at a time. -->
                      <controls:StrataComposerPicker Name="PART_AgentPicker"
                                                     Classes="agents add-list"
                                                     CloseOnSelect="True"
                                                     PlacementTarget="{Binding #PART_AddButton}"
                                                     Icon="{x:Static controls:StrataIcons.Person}"
                                                     Items="{TemplateBinding AvailableAgents}" />

                      <!-- In the window's overlay layer, so its glass frosts the chat beneath it. -->
                      <Popup Name="PART_AddPopup"
                             IsLightDismissEnabled="True"
                             ShouldUseOverlayLayer="True"
                             Placement="AnchorAndGravity"
                             PlacementAnchor="TopLeft"
                             PlacementGravity="TopRight"
                             PlacementConstraintAdjustment="FlipY,ResizeY,SlideX"
                             HorizontalOffset="-12"
                             VerticalOffset="-2"
                             PlacementTarget="{Binding #PART_AddButton}"
                             WindowManagerAddShadowHint="False"
                             strata:PopupAnimationHelper.EnableOpenAnimation="False"
                             strata:PopupAnimationHelper.EnableOverlayAnimation="True"
                             strata:PopupAnimationHelper.OpenAnimationDuration="0:0:0.12">
                        <Panel Width="300" Margin="10" TextOptions.TextRenderingMode="Antialias">
                          <Border CornerRadius="16" ClipToBounds="True" IsHitTestVisible="False">
                            <controls:StrataBackdropBlur CornerRadius="16" BlurRadius="24" Saturation="1.5" />
                          </Border>
                          <Border Name="PART_AddPanel"
                                  Background="{DynamicResource Brush.Surface1Glass}"
                                  BorderBrush="{DynamicResource Brush.BorderDefault}"
                                  BorderThickness="1"
                                  CornerRadius="16"
                                  BoxShadow="0 22 54 -16 #66000000, 0 6 16 -6 #33000000">
                            <DockPanel>
                              <Border Name="PART_AddFooter"
                                      DockPanel.Dock="Bottom"
                                      IsVisible="{TemplateBinding AddMenuHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                      BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                      BorderThickness="0,1,0,0"
                                      Padding="14,9,14,10">
                                <TextBlock Text="{TemplateBinding AddMenuHint}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           TextWrapping="Wrap" />
                              </Border>
                              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="PART_AddMenuList" Margin="6" Spacing="1" />
                              </ScrollViewer>
                            </DockPanel>
                          </Border>
                        </Panel>
                      </Popup>
                    </Panel>

                    <!-- Skills for this chat, one click away -->
                    <controls:StrataComposerPicker Name="PART_SkillPicker"
                                                   Classes="skills"
                                                   Margin="0,0,4,6"
                                                   VerticalAlignment="Center"
                                                   Icon="{x:Static controls:StrataIcons.Wand}"
                                                   Items="{TemplateBinding AvailableSkills}"
                                                   SelectedItems="{TemplateBinding SkillItems}"
                                                   ManageCommand="{TemplateBinding SkillsManageCommand}" />

                    <!-- Connectors (MCP servers) this chat can use -->
                    <Panel Name="PART_McpPanel" Margin="0,0,4,6" VerticalAlignment="Center">
                      <controls:StrataConnectorPicker Name="PART_ConnectorPicker"
                                                     VerticalAlignment="Center"
                                                     Items="{TemplateBinding AvailableMcps}"
                                                     SelectedItems="{TemplateBinding McpItems}"
                                                     ButtonToolTip="{TemplateBinding McpToolTip}"
                                                     Header="{TemplateBinding McpHeader}"
                                                     ErrorActionCommand="{TemplateBinding McpErrorActionCommand}"
                                                     ErrorActionLabel="{TemplateBinding McpErrorActionLabel}"
                                                     ErrorDetailsLabel="{TemplateBinding McpErrorDetailsLabel}"
                                                     CopyErrorDetailsLabel="{TemplateBinding McpCopyErrorDetailsLabel}"
                                                     BrowseCommand="{TemplateBinding McpBrowseCommand}"
                                                     ManageCommand="{TemplateBinding McpManageCommand}"
                                                     IsLoading="{TemplateBinding McpIsLoading}" />
                    </Panel>

                    <!-- Modes ComboBox (Ask / Plan / Agent) -->
                    <ComboBox Name="PART_ModesCombo"
                              Classes="composer-select"
                              ItemsSource="{TemplateBinding Modes}"
                              SelectedItem="{Binding SelectedMode, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              MinWidth="82"
                              Height="30" MinHeight="0" Padding="10,4,8,4"
                              FontSize="{DynamicResource Font.SizeCaption}"
                              CornerRadius="15"
                              Background="{DynamicResource Brush.Surface2}"
                              BorderThickness="0"
                              VerticalAlignment="Center"
                              Margin="0,0,6,6" />

                    <!-- Suggestion loading placeholders -->
                    <StackPanel Name="PART_SuggestionLoading" Orientation="Horizontal" Spacing="6"
                                Margin="0,0,6,6" IsVisible="False" IsHitTestVisible="False">
                      <Border Classes="suggestion-loading-pill phase-a" Width="112" Height="30" CornerRadius="15" />
                      <Border Classes="suggestion-loading-pill phase-b" Width="136" Height="30" CornerRadius="15" />
                      <Border Classes="suggestion-loading-pill phase-c" Width="96" Height="30" CornerRadius="15" />
                    </StackPanel>

                    <!-- Suggestion chips -->
                    <Button Name="PART_ActionA" Classes="subtle suggestion-chip"
                            Height="30" Padding="10,4" MinHeight="0" MaxWidth="260"
                            CornerRadius="15" FontSize="{DynamicResource Font.SizeCaption}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,0,6,6"
                            ToolTip.Tip="{TemplateBinding SuggestionA}"
                            Foreground="{DynamicResource Brush.TextSecondary}">
                      <TextBlock Text="{TemplateBinding SuggestionA}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Name="PART_ActionB" Classes="subtle suggestion-chip"
                            Height="30" Padding="10,4" MinHeight="0" MaxWidth="260"
                            CornerRadius="15" FontSize="{DynamicResource Font.SizeCaption}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,0,6,6"
                            ToolTip.Tip="{TemplateBinding SuggestionB}"
                            Foreground="{DynamicResource Brush.TextSecondary}">
                      <TextBlock Text="{TemplateBinding SuggestionB}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Name="PART_ActionC" Classes="subtle suggestion-chip"
                            Height="30" Padding="10,4" MinHeight="0" MaxWidth="260"
                            CornerRadius="15" FontSize="{DynamicResource Font.SizeCaption}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,0,6,6"
                            ToolTip.Tip="{TemplateBinding SuggestionC}"
                            Foreground="{DynamicResource Brush.TextSecondary}">
                      <TextBlock Text="{TemplateBinding SuggestionC}" TextTrimming="CharacterEllipsis" />
                    </Button>
                      </WrapPanel>

                  <!-- Right: how the chat runs (host settings, then the model), the microphone, then the one button that sends and stops -->
                  <StackPanel Name="PART_PrimaryActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <ContentPresenter Name="PART_TrailingContent"
                                      Content="{TemplateBinding TrailingContent}"
                                      IsVisible="{TemplateBinding TrailingContent, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      VerticalAlignment="Center" />
                    <Panel Name="PART_ModelPickerWrap" VerticalAlignment="Center">
                      <controls:StrataModelPicker Name="PART_ModelPicker"
                                                  Classes="quiet"
                                                  Width="NaN"
                                                  MaxWidth="280"
                                                  VerticalAlignment="Center"
                                                  Models="{TemplateBinding Models}"
                                                  SelectedModel="{Binding SelectedModel, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ModelItemTemplate="{TemplateBinding ModelItemTemplate}"
                                                  SelectedModelTemplate="{TemplateBinding SelectedModelTemplate}"
                                                  ModelPinCommand="{TemplateBinding ModelPinCommand}"
                                                  PinToolTip="{TemplateBinding ModelPinToolTip}"
                                                  UnpinToolTip="{TemplateBinding ModelUnpinToolTip}"
                                                  QualityLevels="{TemplateBinding QualityLevels}"
                                                  SelectedQuality="{Binding SelectedQuality, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ContextWindowTiers="{TemplateBinding ContextWindowTiers}"
                                                  SelectedContextWindowTier="{Binding SelectedContextWindowTier, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  PickerOpenedCommand="{TemplateBinding ModelPickerOpenedCommand}"
                                                  PickerOpenedCommandParameter="{TemplateBinding ModelPickerOpenedCommandParameter}"
                                                  SelectedModelNote="{TemplateBinding ModelNote}"
                                                  SelectedModelNoteActionLabel="{TemplateBinding ModelNoteActionLabel}"
                                                  SelectedModelNoteCommand="{TemplateBinding ModelNoteCommand}" />
                    </Panel>

                    <!-- Dictation: a quiet microphone like the other tools; while listening, the warm disc that finishes. -->
                    <Button Name="PART_VoiceButton"
                            Classes="composer-tool"
                            Width="34" Height="34"
                            Padding="0"
                            CornerRadius="999"
                            IsVisible="False"
                            VerticalAlignment="Center">
                      <Panel Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:StrataLineIcon Name="PART_VoiceMicIcon" StrokeThickness="1.9"
                                                 Data="{x:Static controls:StrataIcons.Mic}" />
                        <controls:StrataLineIcon Name="PART_VoiceDoneIcon" StrokeThickness="2.4" IsVisible="False"
                                                 FlowDirection="LeftToRight"
                                                 Data="{x:Static controls:StrataIcons.Check}" />
                      </Panel>
                    </Button>

                    <Panel Name="PART_SendWrap" VerticalAlignment="Center">
                      <!-- While Lumi works: light breathing around the stop button. -->
                      <Border Name="PART_SendHalo"
                              Margin="-3"
                              CornerRadius="999"
                              BorderThickness="2"
                              BorderBrush="{DynamicResource Brush.ComposerOrbRing}"
                              IsVisible="False"
                              IsHitTestVisible="False"
                              sa:LifecycleOpacityPulse.FromOpacity="1"
                              sa:LifecycleOpacityPulse.ToOpacity="0.3"
                              sa:LifecycleOpacityPulse.Duration="0:0:1.4"
                              sa:LifecycleOpacityPulse.PlaybackDirection="Alternate"
                              sa:LifecycleOpacityPulse.Easing="SineEaseInOut" />
                      <Button Name="PART_SendButton"
                              Width="34" Height="34"
                              Padding="0" MinHeight="0" MinWidth="0"
                              CornerRadius="999"
                              Background="{DynamicResource Brush.AccentGradient}"
                              Foreground="{DynamicResource Brush.TextOnAccent}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Send (Enter)"
                              RenderTransformOrigin="0.5,0.5"
                              RenderTransform="translateY(0px)">
                        <Button.Transitions>
                          <Transitions>
                            <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.1" />
                            <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" Easing="CubicEaseOut" />
                          </Transitions>
                        </Button.Transitions>
                        <Panel>
                          <!-- Touch glyphs: filled shapes sized for a thumb. -->
                          <Viewbox Name="PART_SendGlyphs" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="{DynamicResource Size.IconButtonXS}" Height="{DynamicResource Size.IconButtonXS}">
                              <Path Name="PART_SendIcon"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Data="M8,1.5 L13,6.5 H10.2 V14.5 H5.8 V6.5 H3 Z" />
                              <Path Name="PART_StopIcon"
                                    IsVisible="False"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Data="M4.5,4.5 H11.5 V11.5 H4.5 Z" />
                              <Canvas Name="PART_StopSendIcon"
                                      IsVisible="False"
                                      Width="{DynamicResource Size.IconButtonXS}" Height="{DynamicResource Size.IconButtonXS}">
                                <Path Stretch="Uniform"
                                      Canvas.Left="2.5" Canvas.Top="0"
                                      Width="11" Height="10"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M5.5,0 L11,5 H8.2 V10 H2.8 V5 H0 Z" />
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M3.5,12 H12.5 V14.5 H3.5 Z" />
                              </Canvas>
                            </Grid>
                          </Viewbox>
                          <!-- Desktop glyphs: the composer's line family. -->
                          <Panel Name="PART_OrbGlyphs" Width="18" Height="18" IsVisible="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:StrataLineIcon Name="PART_OrbSendIcon" StrokeThickness="2.2"
                                                     Data="{x:Static controls:StrataIcons.ArrowUp}" />
                            <controls:StrataLineIcon Name="PART_OrbStopSendIcon" StrokeThickness="2.1" IsVisible="False"
                                                     Data="{x:Static controls:StrataIcons.StopSend}" />
                            <Border Name="PART_OrbStopIcon" Width="10" Height="10" CornerRadius="2.5" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                          </Panel>
                        </Panel>
                      </Button>
                    </Panel>
                  </StackPanel>

                  <!-- Dictation: a pulse, the time (or a short status), the live waveform, the language and discard. It
                       takes the tools' column while recording; ComposerLayoutPanel lays out only the first three children. -->
                  <Grid Name="PART_VoiceBar"
                        Grid.Column="1"
                        IsVisible="False"
                        ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                        Height="32"
                        Margin="2,0,8,5"
                        VerticalAlignment="Bottom">
                    <Border Name="PART_VoicePulse"
                            Width="8" Height="8"
                            Margin="8,0,9,0"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.ComposerVoicePulse}"
                            sa:LifecycleOpacityPulse.FromOpacity="1"
                            sa:LifecycleOpacityPulse.ToOpacity="0.3"
                            sa:LifecycleOpacityPulse.Duration="0:0:0.9"
                            sa:LifecycleOpacityPulse.PlaybackDirection="Alternate"
                            sa:LifecycleOpacityPulse.Easing="SineEaseInOut" />
                    <Panel Grid.Column="1" MinWidth="30" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock Name="PART_VoiceElapsed"
                                 Text="0:00"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                      <TextBlock Name="PART_VoiceStatus"
                                 Text="{TemplateBinding VoiceStatus}"
                                 IsVisible="False"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Panel>
                    <controls:StrataVoiceWaveform Name="PART_VoiceWaveform"
                                                  Grid.Column="2"
                                                  Height="22"
                                                  VerticalAlignment="Center"
                                                  Level="{TemplateBinding VoiceLevel}"
                                                  IsActive="{TemplateBinding IsRecording}"
                                                  Foreground="{DynamicResource Brush.ComposerVoiceWave}">
                      <!-- Older sound fades out toward the start edge. -->
                      <controls:StrataVoiceWaveform.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                          <GradientStop Offset="0" Color="#00000000" />
                          <GradientStop Offset="0.22" Color="#FF000000" />
                        </LinearGradientBrush>
                      </controls:StrataVoiceWaveform.OpacityMask>
                    </controls:StrataVoiceWaveform>
                    <!-- The language dictation listens for. -->
                    <Button Name="PART_VoiceLanguageButton"
                            Grid.Column="3"
                            Classes="composer-tool"
                            IsVisible="False"
                            Height="28"
                            Padding="10,0,8,0"
                            CornerRadius="14"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding VoiceLanguageLabel}"
                            AutomationProperties.Name="{TemplateBinding VoiceLanguageLabel}">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Name="PART_VoiceLanguageText"
                                   FontSize="{DynamicResource Font.SizeCaption}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                        <controls:StrataLineIcon Width="12" Height="12"
                                                 StrokeThickness="2.2"
                                                 VerticalAlignment="Center"
                                                 Data="{x:Static controls:StrataIcons.ChevronDown}" />
                      </StackPanel>
                    </Button>
                    <Button Name="PART_VoiceCancelButton"
                            Grid.Column="4"
                            Classes="composer-tool"
                            Width="32" Height="32"
                            Padding="0"
                            CornerRadius="16"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding CancelDictationLabel}"
                            AutomationProperties.Name="{TemplateBinding CancelDictationLabel}">
                      <controls:StrataLineIcon Width="16" Height="16"
                                               StrokeThickness="2"
                                               Data="{x:Static controls:StrataIcons.Cross}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </Grid>
                </Grid>
                </controls:ComposerLayoutPanel>
              </StackPanel>
            </Border>
            </Panel>
          </ControlTemplate>
        </Setter>

        <!-- ── Surface ── -->
        <Style Selector="^ /template/ Border#PART_Root:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerHover}" />
        </Style>

        <!-- Focus: a soft accent ring around the whole card, and the Strata line drawn under the text -->
        <Style Selector="^:focus-within /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComposerFocusBorder}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerFocus}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_FocusLine">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="scaleX(1)" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_FocusSweep">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="sa:LifecycleOffsetSweep.Duration" Value="0:0:2" />
        </Style>
        <Style Selector="^.motion-disabled /template/ Border#PART_FocusLine">
          <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="^.motion-disabled /template/ Border#PART_FocusSweep">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Glass: a translucent card over a frost of whatever runs beneath the composer: the overlay surface at
             two thirds with a hairline rim, frosted like the other floating glass. It stays as clear, with
             no coloured outline. At rest the whole composer sits back a little; while you write (:engaged, focus
             in the composer or in one of its lists) it comes forward as one piece, glass, text and tools together,
             to its full size (the focus depth, scaled on the render thread in StrataChatComposer.FocusDepth.cs).
             With it the shadow deepens, the rim brightens, the top edge catches the light and the Strata line
             draws in under the text, finer than the plain composer's and feathered at its ends. -->
        <Style Selector="^.glass /template/ controls|StrataBackdropBlur#PART_Backdrop">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="BlurRadius" Value="14" />
          <Setter Property="Saturation" Value="1.3" />
        </Style>
        <Style Selector="^.glass /template/ Border#PART_Root">
          <Setter Property="Background" Value="{DynamicResource Brush.ComposerGlassFill}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComposerGlassBorder}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerGlassRest}" />
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.3" Easing="CubicEaseOut" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.4" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^.glass /template/ Border#PART_Root:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComposerGlassBorderHover}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerGlassRest}" />
        </Style>
        <Style Selector="^.glass:engaged /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComposerGlassBorderHover}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerGlassFocus}" />
        </Style>
        <Style Selector="^.glass:engaged /template/ Border#PART_FocusLine">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="scaleX(1)" />
        </Style>
        <Style Selector="^.glass /template/ Border#PART_FocusLine">
          <Setter Property="Height" Value="1.5" />
          <Setter Property="OpacityMask">
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="0.08" Color="#FF000000" />
              <GradientStop Offset="0.92" Color="#FF000000" />
              <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
          </Setter>
        </Style>

        <!-- Chips above the text already set it apart from the card's edge. -->
        <Style Selector="^:has-chips:not(.mobile) /template/ TextBox#PART_Input">
          <Setter Property="Padding" Value="18,12,18,8" />
        </Style>

        <!-- ── Context chips ──
             A neutral pill with a small tile in the kind's hue: lavender agents, steel-blue projects,
             ochre skills, accent chats. Touch hosts restyle them (see the mobile variant). -->
        <Style Selector="^:not(.mobile) /template/ Border#PART_AgentTile">
          <Setter Property="Background" Value="{DynamicResource Brush.ComposerAgentTile}" />
        </Style>
        <Style Selector="^:not(.mobile) /template/ Border#PART_ProjectTile">
          <Setter Property="Background" Value="{DynamicResource Brush.ComposerProjectTile}" />
        </Style>
        <!-- ── Tools ── -->
        <!-- The pickers' own words; hosts localize them with a style on each picker's class. -->
        <Style Selector="^ /template/ controls|StrataComposerPicker#PART_SkillPicker">
          <Setter Property="Label" Value="Skills" />
          <Setter Property="ButtonToolTip" Value="Give Lumi skills for this chat (/)" />
          <Setter Property="SearchWatermark" Value="Search skills" />
          <Setter Property="SelectedLabel" Value="In this chat" />
          <Setter Property="ItemsLabel" Value="All skills" />
          <Setter Property="EmptyTitle" Value="No skills yet" />
          <Setter Property="EmptyText" Value="Skills teach the assistant how to do something your way." />
          <Setter Property="NoResultsFormat" Value="No skills match &#x201C;{0}&#x201D;" />
          <Setter Property="HintText" Value="Tip: type / to add a skill as you write" />
          <Setter Property="ManageLabel" Value="Manage skills" />
        </Style>
        <Style Selector="^ /template/ controls|StrataComposerPicker#PART_ChatPicker">
          <Setter Property="Label" Value="Chats" />
          <Setter Property="SearchWatermark" Value="Search chats" />
          <Setter Property="SelectedLabel" Value="In this message" />
          <Setter Property="ItemsLabel" Value="Recent chats" />
          <Setter Property="EmptyTitle" Value="No other chats yet" />
          <Setter Property="EmptyText" Value="Once you have more conversations, you can bring any of them into a message." />
          <Setter Property="NoResultsFormat" Value="No chats match &#x201C;{0}&#x201D;" />
          <Setter Property="HintText" Value="Tip: type # to find a chat as you write" />
        </Style>
        <Style Selector="^ /template/ controls|StrataConnectorPicker#PART_ConnectorPicker">
          <Setter Property="Label" Value="Connectors" />
        </Style>
        <Style Selector="^:narrow /template/ controls|StrataComposerPicker">
          <Setter Property="ShowLabel" Value="False" />
        </Style>
        <Style Selector="^:narrow /template/ controls|StrataConnectorPicker">
          <Setter Property="ShowLabel" Value="False" />
        </Style>
        <Style Selector="^:not(:has-skill-options) /template/ controls|StrataComposerPicker#PART_SkillPicker">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:has-chat-options) /template/ controls|StrataComposerPicker#PART_ChatPicker">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:has-add-options) /template/ Panel#PART_AddWrap">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:add-open /template/ Button#PART_AddButton">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <!-- ── Send ──
             One round button for the next step: dictate while the message is empty, send once there is
             something to send, stop while Lumi works. Touch hosts keep their filled glyphs and colours. -->
        <Style Selector="^ /template/ Button#PART_SendButton:pointerover">
          <Setter Property="RenderTransform" Value="translateY(0px) scale(1.06)" />
        </Style>
        <Style Selector="^ /template/ Button#PART_SendButton:pressed">
          <Setter Property="RenderTransform" Value="translateY(0px) scale(0.92)" />
        </Style>
        <Style Selector="^.mobile /template/ Button#PART_SendButton:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
        </Style>
        <Style Selector="^.mobile /template/ Button#PART_SendButton:pressed">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPressed}" />
        </Style>

        <!-- Busy: stop mode -->
        <Style Selector="^:busy /template/ Button#PART_SendButton">
          <Setter Property="ToolTip.Tip" Value="Stop generation" />
        </Style>
        <Style Selector="^.mobile:busy /template/ Button#PART_SendButton">
          <Setter Property="Background" Value="{DynamicResource Brush.ComposerStop}" />
        </Style>
        <Style Selector="^.mobile:busy /template/ Button#PART_SendButton:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.ComposerStopHover}" />
        </Style>
        <Style Selector="^:busy /template/ Path#PART_SendIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:busy /template/ Path#PART_StopIcon">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Busy + has text: queue the draft, stop the current turn, then send after cleanup. -->
        <Style Selector="^:stop-send /template/ Button#PART_SendButton">
          <Setter Property="ToolTip.Tip" Value="Stop &amp; send (Enter)" />
        </Style>
        <Style Selector="^.mobile:stop-send /template/ Button#PART_SendButton">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
        </Style>
        <Style Selector="^.mobile:stop-send /template/ Button#PART_SendButton:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
        </Style>
        <Style Selector="^:stop-send /template/ Path#PART_StopIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:stop-send /template/ Canvas#PART_StopSendIcon">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Busy + has text + steering: inject the draft into the running turn without stopping it. -->
        <Style Selector="^:steer /template/ Button#PART_SendButton">
          <Setter Property="ToolTip.Tip" Value="Send to steer (Enter)" />
        </Style>
        <Style Selector="^.mobile:steer /template/ Button#PART_SendButton">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
        </Style>
        <Style Selector="^.mobile:steer /template/ Button#PART_SendButton:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
        </Style>
        <Style Selector="^:steer /template/ Path#PART_StopIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:steer /template/ Canvas#PART_StopSendIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:steer /template/ Path#PART_SendIcon">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Desktop: the composer's line glyphs, chosen by the moment. -->
        <Style Selector="^:not(.mobile) /template/ Viewbox#PART_SendGlyphs">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(.mobile) /template/ Panel#PART_OrbGlyphs">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Nothing to send: a quiet, inactive arrow. -->
        <Style Selector="^:not(.mobile):empty:not(:busy):not(:can-send-without-prompt) /template/ Button#PART_SendButton">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:not(.mobile):empty:not(:busy):not(:can-send-without-prompt) /template/ Button#PART_SendButton:pointerover">
          <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <!-- Working: stop, with light breathing around the button. -->
        <Style Selector="^:not(.mobile):busy:not(:steer):not(:stop-send) /template/ Button#PART_SendButton">
          <Setter Property="Foreground" Value="{DynamicResource Brush.ComposerOrbWorkingForeground}" />
        </Style>
        <Style Selector="^:not(.mobile):busy:not(:steer) /template/ controls|StrataLineIcon#PART_OrbSendIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(.mobile):busy:not(:steer):not(:stop-send) /template/ Border#PART_OrbStopIcon">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(.mobile):stop-send /template/ controls|StrataLineIcon#PART_OrbStopSendIcon">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(.mobile):busy:not(:steer):not(:stop-send):not(:recording) /template/ Border#PART_SendHalo">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
        </Style>
        <Style Selector="^.motion-disabled /template/ Border#PART_SendHalo">
          <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="False" />
        </Style>
        <!-- Dictation has its own button beside send: a quiet microphone, and while listening the warm disc that
             finishes it (a check; its look is with the send button's below). Send steps aside while listening; Enter
             still finishes and sends. -->
        <Style Selector="^:can-voice:not(.mobile):not(:editing) /template/ Button#PART_VoiceButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:recording /template/ controls|StrataLineIcon#PART_VoiceMicIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:recording /template/ controls|StrataLineIcon#PART_VoiceDoneIcon">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(.mobile):recording /template/ Panel#PART_SendWrap">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-voice-languages /template/ Button#PART_VoiceLanguageButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Dictation: the voice bar takes the tools' place and the chat's settings (host settings, the model) step
             aside, so the moment reads as listening. The pulse breathes while sound comes in; a status (starting,
             finishing) takes the timer's place and stills it. The words heard so far wait in quiet text where they
             will land. -->
        <Style Selector="^:not(.mobile):recording /template/ WrapPanel#PART_SecondaryActions">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(.mobile):recording /template/ ContentPresenter#PART_TrailingContent">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(.mobile):recording /template/ Panel#PART_ModelPickerWrap">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(.mobile):recording /template/ Grid#PART_VoiceBar">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:recording:not(:voice-status) /template/ Border#PART_VoicePulse">
          <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
        </Style>
        <Style Selector="^:voice-status /template/ Border#PART_VoicePulse">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="^.motion-disabled /template/ Border#PART_VoicePulse">
          <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="False" />
        </Style>
        <Style Selector="^:voice-status /template/ TextBlock#PART_VoiceElapsed">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:voice-status /template/ TextBlock#PART_VoiceStatus">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(.mobile):recording:voice-preview:empty /template/ controls|ComposerTailPanel#PART_VoicePreviewInlineHost">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(.mobile):recording:voice-preview:not(:empty) /template/ controls|ComposerTailPanel#PART_VoicePreviewHost">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(.mobile):recording:voice-preview /template/ TextBox#PART_Input">
          <Setter Property="PlaceholderText" Value="" />
        </Style>
        <Style Selector="^ /template/ controls|ComposerTailPanel:clipped">
          <Setter Property="OpacityMask">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="0.5" Color="#FF000000" />
            </LinearGradientBrush>
          </Setter>
        </Style>

        <!-- Host-owned edit mode: the integrated StatusContent provides explicit Update/Cancel
             actions, while editing semantics take precedence over busy/steering. -->
        <Style Selector="^:editing /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerFocus}" />
        </Style>
        <Style Selector="^.glass:editing /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComposerFocusBorder}" />
          <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerGlassFocus}" />
        </Style>
        <Style Selector="^:editing /template/ Button#PART_SendButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Empty: dim send (touch) -->
        <Style Selector="^.mobile:empty:not(:busy) /template/ Button#PART_SendButton">
          <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="^.mobile:can-send-without-prompt:not(:busy) /template/ Button#PART_SendButton">
          <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Suggestion loading state -->
        <Style Selector="^:suggestions-generating /template/ StackPanel#PART_SuggestionLoading">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:suggestions-generating /template/ Button#PART_ActionA">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:suggestions-generating /template/ Button#PART_ActionB">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:suggestions-generating /template/ Button#PART_ActionC">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide chips when empty -->
        <Style Selector="^:a-empty /template/ Button#PART_ActionA">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:b-empty /template/ Button#PART_ActionB">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:c-empty /template/ Button#PART_ActionC">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide model picker when no models -->
        <Style Selector="^:not(:has-models) /template/ Panel#PART_ModelPickerWrap">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:has-modes) /template/ ComboBox#PART_ModesCombo">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide the connector picker when there is nothing to pick and nowhere to find more -->
        <Style Selector="^:not(:has-mcp-options) /template/ Panel#PART_McpPanel">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide chips row when there is nothing to carry -->
        <Style Selector="^:not(:has-chips) /template/ WrapPanel#PART_ChipsRow">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide agent chip when no agent is set -->
        <Style Selector="^:not(:has-agent) /template/ Border#PART_AgentChip">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide project chip when no project is set -->
        <Style Selector="^:not(:has-project) /template/ Border#PART_ProjectChip">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ── Send button surfaces (outside the ControlTheme, to reach through two templates) ── -->
  <Style Selector="controls|StrataChatComposer /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="controls|StrataChatComposer /template/ Button#PART_SendButton /template/ Border#PART_Aurora">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Desktop: Lumi's gradient when there is something to send, a quiet disc when there isn't, and a neutral
       disc to stop while Lumi works. -->
  <Style Selector="controls|StrataChatComposer:not(.mobile) /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerOrbReady}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerOrbReady}" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile) /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerOrbReadyHover}" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile):empty:not(:busy):not(:can-send-without-prompt) /template/ Button#PART_SendButton /template/ Border#PART_Surface,
                   controls|StrataChatComposer:not(.mobile):empty:not(:busy):not(:can-send-without-prompt) /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerOrbIdle}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile):busy:not(:steer):not(:stop-send) /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerOrbWorking}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile):busy:not(:steer):not(:stop-send) /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerOrbWorkingHover}" />
  </Style>

  <!-- The microphone is a composer tool (StrataComposerPicker.axaml, included first) until it listens; then it is the
       warm disc that finishes dictation, which these later styles keep when pointed at or pressed. -->
  <Style Selector="controls|StrataChatComposer:recording /template/ Button#PART_VoiceButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>
  <Style Selector="controls|StrataChatComposer:recording /template/ Button#PART_VoiceButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerOrbListening}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.ComposerOrbListening}" />
  </Style>

  <!-- Touch: the accent disc, red while stopping. -->
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton:pressed /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPressed}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile:busy /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerStop}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile:busy /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerStopHover}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile:stop-send /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile:stop-send /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile:steer /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile:steer /template/ Button#PART_SendButton:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
  </Style>

  <!-- Lists the + menu opens appear where the menu was, along the composer's edge rather than
       centred on the + button. (A class activates this style, so it outranks the template's values.) -->
  <Style Selector="controls|StrataComposerPicker.add-list /template/ Popup#PART_Popup">
    <Setter Property="PlacementAnchor" Value="TopLeft" />
    <Setter Property="PlacementGravity" Value="TopRight" />
    <Setter Property="HorizontalOffset" Value="-12" />
    <Setter Property="VerticalOffset" Value="-2" />
  </Style>

  <!-- Other chats and agents have no pill of their own: the + menu opens their lists. -->
  <Style Selector="controls|StrataChatComposer /template/ controls|StrataComposerPicker#PART_ChatPicker /template/ Button#PART_Button,
                   controls|StrataChatComposer /template/ controls|StrataComposerPicker#PART_AgentPicker /template/ Button#PART_Button">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ── The + menu ──
       Rows a pointer or the arrow keys walk: a line icon, a label, then what the row leads to. -->
  <Style Selector="Button.add-menu-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="8,5,10,5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.add-menu-row /template/ Border#PART_Surface">
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="Button.add-menu-row:pressed /template/ Border#PART_Surface">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.add-menu-row:focus-visible /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
  </Style>
  <Style Selector="Button.add-menu-row:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.add-menu-row controls|StrataLineIcon.add-menu-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Button.add-menu-row:pointerover controls|StrataLineIcon.add-menu-icon,
                   Button.add-menu-row:focus-visible controls|StrataLineIcon.add-menu-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button.add-menu-row TextBlock.add-menu-label">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Button.add-menu-row TextBlock.add-menu-meta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.add-menu-row controls|StrataLineIcon.add-menu-chevron">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="Border.add-menu-key">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.PickerTile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PickerTileBorder}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.add-menu-key TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.add-menu-tile">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerChatTile}" />
  </Style>
  <Style Selector="Border.add-menu-tile controls|StrataLineIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="TextBlock.add-menu-header">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.3" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.add-menu-separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,5" />
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
  </Style>

  <!-- Embedded TextBox chrome removal (regular styles, outside ControlTheme) -->
  <Style Selector="TextBox.composer-embed /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.composer-embed:focus /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="TextBox.composer-embed:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="TextBox.composer-embed /template/ Border#FocusAccentBar">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="False" />
  </Style>

  <Style Selector="ComboBox.composer-select /template/ Border#Border">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector="ComboBox.composer-select:pointerover /template/ Border#Border">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}" />
  </Style>
  <Style Selector="ComboBox.composer-select:focus-visible /template/ Border#Border">
    <Setter Property="BoxShadow" Value="0 0 0 1 #28818CF8" />
  </Style>

  <!-- Suggestion chip polish -->
  <Style Selector="Button.suggestion-chip">
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Suggestion loading placeholders -->
  <Style Selector="Border.suggestion-loading-pill">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="Opacity" Value="0.35" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.suggestion-loading-pill.phase-a">
    <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.28" />
    <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.62" />
    <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.95" />
    <Setter Property="sa:LifecycleOpacityPulse.PeakAt" Value="0.38" />
    <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
  </Style>

  <Style Selector="Border.suggestion-loading-pill.phase-b">
    <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.28" />
    <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.62" />
    <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.95" />
    <Setter Property="sa:LifecycleOpacityPulse.HoldUntil" Value="0.18" />
    <Setter Property="sa:LifecycleOpacityPulse.PeakAt" Value="0.56" />
    <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
  </Style>

  <Style Selector="Border.suggestion-loading-pill.phase-c">
    <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="0.28" />
    <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.62" />
    <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.95" />
    <Setter Property="sa:LifecycleOpacityPulse.HoldUntil" Value="0.36" />
    <Setter Property="sa:LifecycleOpacityPulse.PeakAt" Value="0.74" />
    <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
  </Style>

  <!-- ── Context chips (template agent/project chips and the skill/chat chips built in code) ──
       28px pills: a hued tile, the name, and a remove button that brightens on hover. Sizes live
       here rather than on the controls so a touch host can grow them. -->
  <Style Selector="Border.composer-chip-surface">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Border.composer-chip">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerChipFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ComposerChipBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="3,3,4,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.composer-chip Border.chip-tile">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <!-- Desktop: a softer radius sitting within the card's corner, and the × waits until the pointer or the
       keyboard reaches its chip, so a row of chips reads as content, not controls. -->
  <Style Selector="controls|StrataChatComposer:not(.mobile) Border.composer-chip">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile) Border.composer-chip Border.chip-tile">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile) Border.composer-chip Button.chip-remove">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile) Border.composer-chip:pointerover Button.chip-remove,
                   controls|StrataChatComposer:not(.mobile) Border.composer-chip:focus-within Button.chip-remove">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.composer-chip controls|StrataLineIcon.chip-icon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="StrokeThickness" Value="2.1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.composer-chat-chip controls|StrataLineIcon.chip-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="Border.composer-skill-chip controls|StrataLineIcon.chip-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.ComposerSkillHue}" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile) Border.composer-skill-chip Border.chip-tile">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerSkillTile}" />
  </Style>
  <Style Selector="controls|StrataChatComposer:not(.mobile) Border.composer-chat-chip Border.chip-tile">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerChatTile}" />
  </Style>
  <Style Selector="Border.composer-chip TextBlock.chip-glyph">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.composer-chip TextBlock.chip-name">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.composer-chip Button.chip-remove">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.composer-chip TextBlock.chip-remove-icon">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,-1,0,0" />
  </Style>
  <Style Selector="Border.composer-chip Button.chip-remove:pointerover TextBlock.chip-remove-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Border.composer-chip Button.chip-remove:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- Error state for chips (e.g., MCP server failed to connect) -->
  <Style Selector="Border.chip-error-state">
    <Setter Property="BorderBrush" Value="#CC4444" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="TextBlock.chip-error">
    <Setter Property="Foreground" Value="#CC4444" />
  </Style>

  <!-- Autocomplete popup item styles -->
  <Style Selector="Border.autocomplete-item">
    <Setter Property="Background" Value="#00000000" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,7,10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.autocomplete-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
  </Style>
  <Style Selector="Border.autocomplete-item.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerToolActive}" />
  </Style>
  <Style Selector="TextBlock.autocomplete-header">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.3" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="Margin" Value="10,8,10,4" />
  </Style>
  <Style Selector="Border.autocomplete-item Border.autocomplete-glyph-wrap">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{DynamicResource Brush.PickerTile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.PickerTileBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.autocomplete-item.selected Border.autocomplete-glyph-wrap">
    <Setter Property="Background" Value="{DynamicResource Brush.PickerTileSelected}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.autocomplete-item TextBlock.autocomplete-glyph">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Border.autocomplete-item controls|StrataLineIcon.autocomplete-icon">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="Border.autocomplete-item TextBlock.autocomplete-name">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="Border.autocomplete-item TextBlock.autocomplete-secondary">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="Border.autocomplete-item Border.autocomplete-trailing-badge">
    <Setter Property="Background" Value="{DynamicResource Brush.PickerTile}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.autocomplete-item.selected Border.autocomplete-trailing-badge">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.autocomplete-item TextBlock.autocomplete-trailing-text">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════════════════════════
       Touch variant — Classes="mobile"

       The default template is a desktop toolbar: a wrapping row of 28dp controls under the input,
       carrying an inline model picker, a modes combo, an MCP button and three suggestion chips.
       On a phone that is a dense strip of targets too small to hit reliably, and it eats the
       vertical space the input itself needs.

       This variant keeps the same control and the same parts — so all the behaviour, bindings and
       commands are untouched — and restates the geometry for a thumb: a near-pill container, a
       taller input, one row of large round buttons, and everything that belongs in a sheet on a
       phone (model, modes, MCP, suggestions) hidden here and surfaced by the host instead.
       ═══════════════════════════════════════════════════════════════════════════════════════════ -->

  <Style Selector="controls|StrataChatComposer.mobile /template/ Border#PART_Root">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- The input is the point of the control, so it gets real height and body-sized text. -->
  <Style Selector="controls|StrataChatComposer.mobile /template/ TextBox#PART_Input">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MaxHeight" Value="176" />
    <Setter Property="Padding" Value="12,10,12,10" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="textInput:TextInputOptions.ReturnKeyType" Value="Return" />
  </Style>

  <Style Selector="controls|StrataChatComposer:external-editor /template/ TextBox#PART_Input">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|StrataChatComposer:external-editor /template/ ContentPresenter#PART_EditorContent">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|StrataChatComposer:external-editor:editor-content-hidden /template/ ContentPresenter#PART_EditorContent">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|StrataChatComposer:external-editor:editor-content-hidden /template/ TextBox#PART_Input">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ Grid#PART_Toolbar">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ StackPanel#PART_PrimaryActions">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ ContentPresenter#PART_LeadingContent">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ ScrollViewer#PART_ContextScroll">
    <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ ContentPresenter#PART_AttachmentContent">
    <Setter Property="Margin" Value="8,0,8,0" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ controls|ComposerLayoutPanel">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Expansion" Duration="0:0:0.28" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile:compact /template/ controls|ComposerLayoutPanel">
    <Setter Property="Expansion" Value="0" />
  </Style>

  <!-- Mobile hosts attach inside their own non-wrapping toolbar content so attach + run settings stay
       on one row at 360dp, and reach chats, skills and agents through their own sheets: the desktop
       + menu stays out of the row. -->
  <Style Selector="controls|StrataChatComposer.mobile /template/ Panel#PART_AddWrap">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton:pointerover">
    <Setter Property="RenderTransform" Value="translateY(0px) scale(1.05)" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton:pressed">
    <Setter Property="RenderTransform" Value="translateY(0px) scale(0.92)" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton /template/ Panel">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton /template/ Border#PART_Surface">
    <Setter Property="Margin" Value="5" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_SendButton /template/ Border#PART_FocusRing">
    <Setter Property="Margin" Value="3" />
  </Style>

  <!--
    Hidden on touch, not removed: each of these is a desktop affordance whose mobile equivalent is a
    bottom sheet the host opens. Leaving them visible put five sub-30dp targets in a row a thumb
    cannot separate.
  -->
  <Style Selector="controls|StrataChatComposer.mobile /template/ ComboBox#PART_ModesCombo">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Panel#PART_ModelPickerWrap">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Panel#PART_McpPanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_ActionA,
                   controls|StrataChatComposer.mobile /template/ Button#PART_ActionB,
                   controls|StrataChatComposer.mobile /template/ Button#PART_ActionC,
                   controls|StrataChatComposer.mobile /template/ StackPanel#PART_SuggestionLoading">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Chips: full-height rows a thumb can actually dismiss. -->
  <Style Selector="controls|StrataChatComposer.mobile /template/ Border#PART_AgentChip,
                   controls|StrataChatComposer.mobile /template/ Border#PART_ProjectChip">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,7,7,7" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ Button#PART_AgentRemoveButton,
                   controls|StrataChatComposer.mobile /template/ Button#PART_ProjectRemoveButton">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>
  <Style Selector="controls|StrataChatComposer.mobile /template/ WrapPanel#PART_ChipsRow">
    <Setter Property="Margin" Value="16,12,16,0" />
  </Style>

  <!-- Skills and chats are desktop pickers; a phone reaches them through the host's own sheets. -->
  <Style Selector="controls|StrataChatComposer.mobile /template/ controls|StrataComposerPicker">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>
