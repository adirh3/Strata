<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls"
        xmlns:sa="using:StrataTheme.Animation">

  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataAiToolCall}" TargetType="controls:StrataAiToolCall">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
          <ControlTemplate>
            <!-- One row of a card: what the step is, what it worked on and how long it took. -->
            <Border Name="PART_Root"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="9"
                    ClipToBounds="True">
              <Border.Transitions>
                <Transitions>
                  <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.14" />
                  <sa:PremultipliedBrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
              </Border.Transitions>

              <StackPanel Spacing="0">
                <Border Name="PART_Header"
                        Cursor="Hand"
                        Padding="7,6,8,6"
                        CornerRadius="8"
                        Background="Transparent">
                  <Border.Transitions>
                    <Transitions>
                      <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.12" />
                    </Transitions>
                  </Border.Transitions>
                  <!-- DockPanel, not Grid: the name and detail are measured against the space that is
                       left, so they trim instead of pushing the time past the row's edge. -->
                  <DockPanel>
                    <Border Name="PART_StateDot"
                            DockPanel.Dock="Left"
                            Width="6" Height="6"
                            Margin="4,0,12,0"
                            CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.TextTertiary}" />
                    <controls:StrataLineIcon Name="PART_Icon"
                                             DockPanel.Dock="Left"
                                             Width="14" Height="14"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             IsVisible="False"
                                             Data="{TemplateBinding Icon}"
                                             Foreground="{DynamicResource Brush.TextTertiary}" />
                    <controls:StrataLineIcon Name="PART_ExpandIcon"
                                             DockPanel.Dock="Right"
                                             Width="11" Height="11"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Opacity="0"
                                             StrokeThickness="2"
                                             Data="{x:Static controls:StrataIcons.ChevronDown}"
                                             Foreground="{DynamicResource Brush.TextTertiary}"
                                             RenderTransformOrigin="50%,50%"
                                             RenderTransform="rotate(0deg)">
                      <controls:StrataLineIcon.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        </Transitions>
                      </controls:StrataLineIcon.Transitions>
                    </controls:StrataLineIcon>
                    <TextBlock Name="PART_StatusText"
                               DockPanel.Dock="Right"
                               Margin="12,0,0,0"
                               Text="{Binding GlanceText, RelativeSource={RelativeSource TemplatedParent}}"
                               IsVisible="{Binding GlanceText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                    <ContentPresenter Name="PART_HeaderAction"
                                      DockPanel.Dock="Right"
                                      Margin="8,0,0,0"
                                      Content="{TemplateBinding HeaderAction}"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HeaderAction, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Name="PART_ToolName"
                               DockPanel.Dock="Left"
                               Margin="0,0,7,0"
                               Text="{TemplateBinding ToolName}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <TextBlock Name="PART_DetailText"
                               Text="{TemplateBinding Detail}"
                               IsVisible="False"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                  </DockPanel>
                </Border>

                <!-- Details and output, recessed under the name. -->
                <Border Name="PART_Detail"
                        ClipToBounds="True"
                        IsVisible="False"
                        MaxHeight="0"
                        Opacity="0"
                        Margin="29,0,8,8"
                        CornerRadius="10"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.GlassWell}"
                        BorderBrush="{DynamicResource Brush.GlassDivider}"
                        RenderTransformOrigin="0.5,0"
                        RenderTransform="translateY(-4px) scaleY(0.96)">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxHeight" Duration="0:0:0.26" Easing="CubicEaseOut" />
                      <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>

                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <controls:StrataToolDetails Name="PART_Details" Margin="12,10,12,11" />
                  </ScrollViewer>
                </Border>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>

        <!-- ─── What it is ─── -->
        <Style Selector="^:has-icon /template/ Border#PART_StateDot">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-icon /template/ controls|StrataLineIcon#PART_Icon">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-detail /template/ TextBlock#PART_DetailText">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ─── Hover and open: the row's header tints; a row with details shows its chevron ─── -->
        <Style Selector="^ /template/ Border#PART_Header:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ TextBlock#PART_ToolName">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="^:pointerover:has-params /template/ controls|StrataLineIcon#PART_ExpandIcon, ^:pointerover:has-info /template/ controls|StrataLineIcon#PART_ExpandIcon">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Open: only a row with something to show opens; the chevron turns and the well reveals it. -->
        <Style Selector="^:expanded:has-params /template/ controls|StrataLineIcon#PART_ExpandIcon, ^:expanded:has-info /template/ controls|StrataLineIcon#PART_ExpandIcon">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:expanded:has-params /template/ Border#PART_Detail, ^:expanded:has-info /template/ Border#PART_Detail">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="MaxHeight" Value="600" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="translateY(0) scaleY(1)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>

        <!-- ─── Running: the accent marks it and the time counts up ─── -->
        <Style Selector="^:inprogress /template/ controls|StrataLineIcon#PART_Icon">
          <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>
        <Style Selector="^:inprogress /template/ TextBlock#PART_ToolName">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="^:inprogress /template/ TextBlock#PART_StatusText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>
        <Style Selector="^:inprogress /template/ Border#PART_StateDot">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
          <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
          <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.35" />
          <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:0.92" />
          <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="CompositorDefault" />
          <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
        </Style>

        <!-- ─── Failed: the icon and the word say so; nothing else changes ─── -->
        <Style Selector="^:failed /template/ controls|StrataLineIcon#PART_Icon">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>
        <Style Selector="^:failed /template/ Border#PART_StateDot">
          <Setter Property="Background" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>
        <Style Selector="^:failed /template/ TextBlock#PART_StatusText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- A step's opened details (StrataToolDetails): its fields in a key column, then what it reported.
       Keys and values share an 18px line, so their first lines align. -->
  <Style Selector="controls|StrataToolDetails TextBlock.tool-detail-key">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="MaxWidth" Value="140" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="controls|StrataToolDetails SelectableTextBlock.tool-detail-value">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataToolDetails SelectableTextBlock.tool-detail-result">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataToolDetails DockPanel.tool-detail-error SelectableTextBlock.tool-detail-result">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataToolDetails controls|StrataLineIcon.tool-detail-error-icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="0,2,8,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>
  <Style Selector="controls|StrataToolDetails Border.tool-detail-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.GlassDivider}" />
  </Style>
</Styles>
