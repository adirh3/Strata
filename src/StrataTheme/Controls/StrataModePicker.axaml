<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls"
        xmlns:strata="using:StrataTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Brush.ModePickerSwitchTrack" Color="#1F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Brush.ModePickerSwitchTrack" Color="#2EFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

  <!-- Quiet text action in the host's content, such as a link to settings. Strata gives every
       TextBlock the body size and colour, so the panel's mode-picker-link styles hand a text the
       button's own, and one state change recolours it. -->
  <ControlTheme x:Key="ModePickerLinkTheme" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="Transparent"
                          BorderThickness="1"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          Foreground="{TemplateBinding Foreground}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
          <ContentPresenter.Transitions>
            <Transitions>
              <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
          </ContentPresenter.Transitions>
        </ContentPresenter>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
    </Style>
    <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFocus}" />
    </Style>
  </ControlTheme>

  <!-- Compact switch for an option under the modes, the size the connector picker's rows use: the
       track takes the accent gradient when on, like Strata's ToggleSwitch. -->
  <ControlTheme x:Key="ModePickerSwitchTheme" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Track"
                  CornerRadius="9"
                  Background="{DynamicResource Brush.ModePickerSwitchTrack}"
                  BorderBrush="Transparent"
                  BorderThickness="1" />
          <Border Name="PART_OnTrack"
                  CornerRadius="9"
                  Background="{DynamicResource Brush.AccentGradient}"
                  Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Ellipse Name="PART_Knob"
                   Width="12" Height="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="3,0,0,0"
                   Fill="{DynamicResource Brush.TextSecondary}"
                   RenderTransform="translateX(0px)">
            <Ellipse.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
              </Transitions>
            </Ellipse.Transitions>
          </Ellipse>
          <Border Name="PART_FocusRing"
                  Margin="-3"
                  CornerRadius="12"
                  BorderBrush="Transparent"
                  BorderThickness="1.5"
                  IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Track">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_OnTrack">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#PART_Knob">
      <Setter Property="Fill" Value="White" />
      <Setter Property="RenderTransform" Value="translateX(12px)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderFocus}" />
    </Style>
  </ControlTheme>
  <!-- One row per mode, its check drawn by the row itself. -->
  <ControlTheme x:Key="ModePickerItemTheme" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.GlassAccentTint}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:StrataModePicker}" TargetType="controls:StrataModePicker">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Button Name="PART_Button"
                  Classes="composer-tool"
                  Height="30" MinHeight="0" MinWidth="30"
                  CornerRadius="15"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{TemplateBinding ButtonToolTip}"
                  AutomationProperties.Name="{TemplateBinding ButtonToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <controls:StrataLineIcon Name="PART_Icon"
                                       Width="16" Height="16"
                                       StrokeThickness="1.8"
                                       Data="{TemplateBinding Icon}"
                                       VerticalAlignment="Center" />
              <TextBlock Name="PART_Label"
                         Text="{TemplateBinding Label}"
                         FontSize="{DynamicResource Font.SizeCaption}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         IsVisible="False" />
            </StackPanel>
          </Button>

          <!-- In the window's overlay layer, so its glass frosts the chat beneath it. -->
          <Popup Name="PART_Popup"
                 IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                 IsLightDismissEnabled="True"
                 ShouldUseOverlayLayer="True"
                 Placement="AnchorAndGravity"
                 PlacementAnchor="TopRight"
                 PlacementGravity="TopLeft"
                 PlacementConstraintAdjustment="FlipY,ResizeY,SlideX"
                 HorizontalOffset="12"
                 VerticalOffset="-2"
                 PlacementTarget="{Binding #PART_Button}"
                 WindowManagerAddShadowHint="False"
                 strata:PopupAnimationHelper.EnableOpenAnimation="False"
                 strata:PopupAnimationHelper.EnableOverlayAnimation="True"
                 strata:PopupAnimationHelper.OpenAnimationDuration="0:0:0.12">
            <Panel Width="340" Margin="10">
              <!-- What the host's footer is built from, scoped here so nothing else pays for these
                   rules: a quiet text action, a compact switch, and the icon tile the modes wear
                   (`on` lights its icon). -->
              <Panel.Styles>
                <Style Selector="Button.mode-picker-link">
                  <Setter Property="Theme" Value="{StaticResource ModePickerLinkTheme}" />
                </Style>
                <Style Selector="Button.mode-picker-link TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
                <Style Selector="ToggleButton.mode-picker-switch">
                  <Setter Property="Theme" Value="{StaticResource ModePickerSwitchTheme}" />
                </Style>
                <Style Selector="Border.mode-picker-tile">
                  <Setter Property="Width" Value="30" />
                  <Setter Property="Height" Value="30" />
                  <Setter Property="CornerRadius" Value="10" />
                  <Setter Property="VerticalAlignment" Value="Top" />
                  <Setter Property="Background" Value="{DynamicResource Brush.GlassWell}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassDivider}" />
                  <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style Selector="Border.mode-picker-tile > controls|StrataLineIcon">
                  <Setter Property="Width" Value="15" />
                  <Setter Property="Height" Value="15" />
                  <Setter Property="StrokeThickness" Value="1.8" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </Style>
                <Style Selector="Border.mode-picker-tile.on > controls|StrataLineIcon">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
                </Style>
              </Panel.Styles>
              <Border CornerRadius="16" ClipToBounds="True" IsHitTestVisible="False">
                <controls:StrataBackdropBlur CornerRadius="16" BlurRadius="24" Saturation="1.5" />
              </Border>
              <Border Background="{DynamicResource Brush.Surface1Glass}"
                      BorderBrush="{DynamicResource Brush.BorderDefault}"
                      BorderThickness="1"
                      CornerRadius="16"
                      BoxShadow="0 22 54 -16 #66000000, 0 6 16 -6 #33000000">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="16,14,16,6" Spacing="3">
                    <TextBlock Text="{TemplateBinding Header}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{TemplateBinding Description}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Border DockPanel.Dock="Bottom"
                          BorderBrush="{DynamicResource Brush.BorderSubtle}"
                          BorderThickness="0,1,0,0"
                          Padding="16,10,16,12"
                          IsVisible="{TemplateBinding FooterContent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentPresenter Name="PART_Footer" Content="{TemplateBinding FooterContent}" />
                  </Border>
                  <ListBox Name="PART_List"
                           Classes="mode-list"
                           Margin="6,2,6,6"
                           Padding="0"
                           Background="Transparent"
                           BorderThickness="0"
                           SelectionMode="Single"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ItemContainerTheme="{StaticResource ModePickerItemTheme}"
                           ItemsSource="{TemplateBinding Items}"
                           ItemTemplate="{TemplateBinding ItemTemplate}" />
                </DockPanel>
              </Border>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ controls|StrataLineIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="^ /template/ Button#PART_Button">
      <Setter Property="Padding" Value="7,0" />
    </Style>
    <Style Selector="^:labelled /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:labelled /template/ Button#PART_Button">
      <Setter Property="Padding" Value="9,0,12,0" />
    </Style>
    <Style Selector="^:accent /template/ controls|StrataLineIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="^:accent /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    </Style>
    <Style Selector="^:caution /template/ controls|StrataLineIcon#PART_Icon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
    <Style Selector="^:caution /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
    </Style>
  </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- The button's surface lives in the Button's own template, so a tone reaches it from here,
       outside the ControlTheme, like the composer's other pickers. -->
  <Style Selector="controls|StrataModePicker:accent /template/ Button#PART_Button /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.GlassAccentTint}" />
  </Style>
  <Style Selector="controls|StrataModePicker:caution /template/ Button#PART_Button /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
  </Style>
  <Style Selector="controls|StrataModePicker:open /template/ Button#PART_Button /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.ComposerToolCatchPressed}" />
  </Style>
</Styles>
