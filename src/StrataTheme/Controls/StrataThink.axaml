<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataThink}" TargetType="controls:StrataThink">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <!-- Single rounded container — fixed radius, just grows in height -->
             <Border Name="PART_Pill"
                    Background="{DynamicResource Brush.ControlDefault}"
                    BorderBrush="{DynamicResource Brush.ControlElevationBorder}"
                    BorderThickness="{DynamicResource Stroke.Thin}"
                    CornerRadius="{DynamicResource Radius.Base}"
                    Padding="12,7,12,7"
                    BoxShadow="0 1 2 0 #0A000000"
                    ClipToBounds="True"
                    HorizontalAlignment="Left">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                  <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                  <ThicknessTransition Property="Padding" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  <DoubleTransition Property="Width" Duration="0:0:0.26" Easing="CubicEaseOut" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
              </Border.Transitions>

              <StackPanel Spacing="0">
                <!-- Clickable header region — only this area toggles expand/collapse -->
                <Border Name="PART_Header" Background="Transparent" Cursor="Hand">
                  <StackPanel Spacing="0">
                    <Grid Name="PART_HeaderRow" ColumnDefinitions="Auto,6,Auto,8,Auto,4,Auto,Auto" VerticalAlignment="Center">
                      <Border Name="PART_Dot"
                              Width="6" Height="6"
                              CornerRadius="3"
                              Background="{DynamicResource Brush.TextTertiary}">
                        <Border.Transitions>
                          <Transitions>
                            <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.2" />
                          </Transitions>
                        </Border.Transitions>
                      </Border>
                      <TextBlock Name="PART_LabelText"
                                 Text="{TemplateBinding Label}"
                                 Grid.Column="2"
                                 FontSize="{DynamicResource Font.SizeCaption}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.TextSecondary}"
                                 MaxWidth="360"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1" />

                      <TextBlock Name="PART_MetaText"
                                 Grid.Column="4"
                                 Text="{TemplateBinding Meta}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.TextTertiary}"
                                 MaxWidth="180"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1"
                                 IsVisible="False" />
                      <ContentPresenter Grid.Column="6"
                                        Content="{TemplateBinding HeaderExtra}"
                                        VerticalAlignment="Center" />
                      <PathIcon Name="PART_ExpandIcon"
                                Grid.Column="7"
                                IsVisible="False"
                                Width="10" Height="10" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Data="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"
                                RenderTransformOrigin="50%,50%">
                        <PathIcon.Transitions>
                          <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                          </Transitions>
                        </PathIcon.Transitions>
                      </PathIcon>
                    </Grid>

                    <Border Name="PART_ProgressHost"
                            IsVisible="False"
                            Margin="0,6,0,0">
                      <ProgressBar Name="PART_Progress"
                                   Minimum="0"
                                   Maximum="100"
                                   Height="3"
                                   Value="{TemplateBinding ProgressValue}" />
                    </Border>
                  </StackPanel>
                </Border>

                <ContentPresenter Name="PART_PreviewHost"
                                  Content="{TemplateBinding DisplayedPreviewContent}"
                                  IsVisible="False"
                                  Margin="0,12,0,0"
                                  HorizontalContentAlignment="Stretch" />

                <!-- Content area — animated MaxHeight reveal, no inner ScrollViewer -->
                <Border Name="PART_ContentHost"
                        ClipToBounds="True"
                        IsVisible="False"
                        MaxHeight="0"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0"
                        RenderTransform="translateY(-6px) scaleY(0.94)">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut" />
                      <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                  <StackPanel>
                    <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}" Margin="0,6,0,6" />
                    <Border Padding="0,0,2,0">
                      <ContentPresenter Content="{TemplateBinding DisplayedContent}"
                                        HorizontalAlignment="Stretch" />
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>

        <!-- Expanded: grow width + reveal content, NO corner radius change -->
        <Style Selector="^[IsExpanded=True] /template/ Border#PART_Pill">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
          <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
        </Style>
        <Style Selector="^[IsExpanded=True] /template/ Border#PART_ContentHost">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="MaxHeight" Value="5000" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="translateY(0) scaleY(1)" />
        </Style>

        <!-- Active state: accent dot -->
        <Style Selector="^:active /template/ Border#PART_Dot">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
          <Setter Property="sa:LifecycleOpacityPulse.FromOpacity" Value="1" />
          <Setter Property="sa:LifecycleOpacityPulse.ToOpacity" Value="0.3" />
          <Setter Property="sa:LifecycleOpacityPulse.Duration" Value="0:0:1.4" />
          <Setter Property="sa:LifecycleOpacityPulse.Easing" Value="CompositorDefault" />
          <Setter Property="sa:LifecycleOpacityPulse.IsActive" Value="True" />
        </Style>

        <Style Selector="^:has-meta /template/ TextBlock#PART_MetaText">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:has-progress /template/ Border#PART_ProgressHost">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:complete /template/ ProgressBar#PART_Progress">
          <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
        </Style>

        <!-- Hover -->
        <Style Selector="^ /template/ Border#PART_Pill:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.ControlHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlElevationBorder}" />
          <Setter Property="BoxShadow" Value="0 2 6 0 #0E000000, 0 1 2 0 #06000000" />
        </Style>

        <Style Selector="^[IsExpanded=True] /template/ Border#PART_Pill:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
          <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
        </Style>

        <Style Selector="^:pressed /template/ Border#PART_Pill">
          <Setter Property="Background" Value="{DynamicResource Brush.ControlPressed}" />
          <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
          <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Pill">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>

        <!-- Activity previews use a quiet card, without changing ordinary reasoning pills. -->
        <Style Selector="^:activity /template/ Border#PART_Pill">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface0}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
          <Setter Property="CornerRadius" Value="{DynamicResource Radius.Interactive}" />
          <Setter Property="Padding" Value="{DynamicResource Padding.Section}" />
          <Setter Property="BoxShadow" Value="none" />
          <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="^:activity /template/ Border#PART_Pill:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface0}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
          <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="^:activity:focus-visible /template/ Border#PART_Pill">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>
        <Style Selector="^:activity /template/ TextBlock#PART_LabelText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
          <Setter Property="MaxWidth" Value="Infinity" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:activity /template/ TextBlock#PART_MetaText">
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:activity /template/ Border#PART_ProgressHost">
          <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="^:activity /template/ ProgressBar#PART_Progress">
          <Setter Property="Height" Value="2" />
        </Style>
        <Style Selector="^:activity /template/ PathIcon#PART_ExpandIcon">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:activity[IsExpanded=True] /template/ PathIcon#PART_ExpandIcon">
          <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:preview /template/ ContentPresenter#PART_PreviewHost">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
