<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">

  <!-- ═══════════════════════════════════════════
       StrataTypingIndicator
       Inline status on the transcript's glass: three accent dots + label
       ═══════════════════════════════════════════ -->

  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataTypingIndicator}" TargetType="controls:StrataTypingIndicator">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel HorizontalAlignment="Left">
            <!-- Optional frost behind the translucent pill, for hosts that float it over moving content;
                 they turn it on by style. -->
            <controls:StrataBackdropBlur Name="PART_Backdrop"
                                         IsVisible="False"
                                         CornerRadius="{Binding CornerRadius, ElementName=PART_Surface}" />
            <Border Name="PART_Surface"
                    Background="{DynamicResource Brush.GlassFill}"
                    BorderBrush="{DynamicResource Brush.GlassRim}"
                    BorderThickness="1"
                    CornerRadius="999"
                    BoxShadow="{DynamicResource Shadow.GlassChip}"
                    Padding="12,7,13,7"
                    HorizontalAlignment="Left">

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Border Name="PART_Dot1"
                          Width="5" Height="5" CornerRadius="2.5"
                          Background="{DynamicResource Brush.AccentDefault}" />
                  <Border Name="PART_Dot2"
                          Width="5" Height="5" CornerRadius="2.5"
                          Background="{DynamicResource Brush.AccentDefault}" />
                  <Border Name="PART_Dot3"
                          Width="5" Height="5" CornerRadius="2.5"
                          Background="{DynamicResource Brush.AccentDefault}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{TemplateBinding Label}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
              </Grid>
            </Border>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:active /template/ Border#PART_Surface:pointerover">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRimHover}" />
        </Style>

        <Style Selector="^:not(:active)">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
