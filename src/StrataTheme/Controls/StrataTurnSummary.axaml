<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls"
        xmlns:sa="using:StrataTheme.Animation">
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataTurnSummary}" TargetType="controls:StrataTurnSummary">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Spacing="0">

              <!-- A quiet line that says how the work went; hovering it lifts it onto glass. -->
              <Border Name="PART_Header"
                      Cursor="Hand"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="8,5,10,5">
                <!-- Premultiplied: from Transparent (white at zero alpha) a plain brush transition
                     fades through light grey, a flash over the dark transcript. -->
                <Border.Transitions>
                  <Transitions>
                    <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.16" />
                    <sa:PremultipliedBrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                  </Transitions>
                </Border.Transitions>

                <DockPanel>
                  <Panel DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center">
                    <controls:StrataLineIcon Name="PART_Glyph"
                                             Width="14" Height="14"
                                             Data="{x:Static controls:StrataIcons.CheckCircle}"
                                             Foreground="{DynamicResource Brush.TextTertiary}" />
                    <controls:StrataLineIcon Name="PART_FailureGlyph"
                                             Width="14" Height="14"
                                             IsVisible="False"
                                             Data="{x:Static controls:StrataIcons.Alert}"
                                             Foreground="{DynamicResource Brush.DangerDefault}" />
                  </Panel>
                  <controls:StrataLineIcon Name="PART_ExpandIcon"
                                           DockPanel.Dock="Right"
                                           Width="11" Height="11"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           StrokeThickness="2"
                                           Data="{x:Static controls:StrataIcons.ChevronDown}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           RenderTransformOrigin="50%,50%"
                                           RenderTransform="rotate(0deg)">
                    <controls:StrataLineIcon.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                      </Transitions>
                    </controls:StrataLineIcon.Transitions>
                  </controls:StrataLineIcon>
                  <TextBlock Name="PART_Label"
                             Text="{TemplateBinding Label}"
                             FontSize="12.5"
                             Foreground="{DynamicResource Brush.TextTertiary}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             MaxLines="1" />
                </DockPanel>
              </Border>

              <!-- The folded work hangs on a hairline under the icon. The control reveals it from the
                   top while it fades in; the content keeps its natural layout throughout. -->
              <controls:TurnSummaryRevealHost Name="PART_ContentHost"
                                              IsVisible="False"
                                              Reveal="0"
                                              Opacity="0">
                <Border Padding="16,4,0,4"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource Brush.GlassDivider}"
                        Margin="15,2,0,0"
                        controls:StrataTurnSummary.IsWithinSummary="True">
                  <ContentPresenter Content="{TemplateBinding DisplayedContent}" />
                </Border>
              </controls:TurnSummaryRevealHost>

            </StackPanel>
          </ControlTemplate>
        </Setter>

        <!-- Something failed: the line says so with its icon -->
        <Style Selector="^:has-failures /template/ controls|StrataLineIcon#PART_Glyph">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-failures /template/ controls|StrataLineIcon#PART_FailureGlyph">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Hover: the line sits on the transcript's glass -->
        <Style Selector="^ /template/ Border#PART_Header:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.GlassFill}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.GlassRim}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Header:pointerover TextBlock#PART_Label">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>

        <!-- Open: the chevron turns -->
        <Style Selector="^:expanded /template/ controls|StrataLineIcon#PART_ExpandIcon">
          <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:expanded /template/ TextBlock#PART_Label">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>

        <!-- Focus -->
        <Style Selector="^:focus-visible /template/ Border#PART_Header">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>

      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
