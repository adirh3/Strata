<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataConfidence}" TargetType="controls:StrataConfidence">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Spacing="8">
              <!-- What is being rated on the left; how sure, in a number and a word, on the right. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{TemplateBinding Label}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextSecondary}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                  <TextBlock Name="PART_PercentText"
                             FontSize="15"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             Text="72%" />
                  <Border Name="PART_BandBadge"
                          CornerRadius="999"
                          Padding="8,2"
                          VerticalAlignment="Center"
                          Background="{DynamicResource Brush.AccentSubtle}">
                    <Border.Transitions>
                      <Transitions>
                        <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.2" />
                      </Transitions>
                    </Border.Transitions>
                    <TextBlock Name="PART_BandText"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.AccentDefault}"
                               Text="{controls:InteractiveLabel confidenceMedium}">
                      <TextBlock.Transitions>
                        <Transitions>
                          <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                        </Transitions>
                      </TextBlock.Transitions>
                    </TextBlock>
                  </Border>
                </StackPanel>
              </Grid>

              <Border Name="PART_Track"
                      Height="6"
                      CornerRadius="999"
                      Background="{DynamicResource Brush.SubtleHover}"
                      ClipToBounds="True"
                      RenderTransformOrigin="0.5,0.5"
                      RenderTransform="scale(1)">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
                <Border Name="PART_Fill"
                        Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="999"
                        Background="{DynamicResource Brush.AccentGradient}">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </Border>

              <ContentPresenter Content="{TemplateBinding Explanation}"
                                IsVisible="{Binding Explanation, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
                                TextElement.Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:high /template/ Border#PART_BandBadge">
          <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
        </Style>
        <Style Selector="^:high /template/ TextBlock#PART_BandText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>

        <Style Selector="^:medium /template/ Border#PART_BandBadge">
          <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
        </Style>
        <Style Selector="^:medium /template/ TextBlock#PART_BandText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
        </Style>
        <Style Selector="^:medium /template/ Border#PART_Fill">
          <Setter Property="Background" Value="{DynamicResource Brush.WarningDefault}" />
        </Style>

        <Style Selector="^:low /template/ Border#PART_BandBadge">
          <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
        </Style>
        <Style Selector="^:low /template/ TextBlock#PART_BandText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>
        <Style Selector="^:low /template/ Border#PART_Fill">
          <Setter Property="Background" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>

        <Style Selector="^:editable /template/ Border#PART_Track">
          <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="^:editable /template/ Border#PART_Track:pointerover">
          <Setter Property="RenderTransform" Value="scaleY(1.4)" />
        </Style>

        <Style Selector="^:focus-visible /template/ Border#PART_Track">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
