<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- A console's text: a quiet prompt, the command in full strength, output a step back. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Brush.TerminalPreviewPrompt">#FF79747E</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TerminalPreviewCommand">#FF1B1B1F</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TerminalPreviewOutput">#FF49454F</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Brush.TerminalPreviewPrompt">#FF8A8A8A</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TerminalPreviewCommand">#FFE4E4E4</SolidColorBrush>
          <SolidColorBrush x:Key="Brush.TerminalPreviewOutput">#FFB0B0B0</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ControlTheme x:Key="{x:Type controls:StrataTerminalPreview}" TargetType="controls:StrataTerminalPreview">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
          <ControlTemplate>
            <!-- A row like any other step, with the command beside its name, that opens onto its console. -->
            <Border Name="PART_Root"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="9"
                    ClipToBounds="True">
              <Border.Transitions>
                <Transitions>
                  <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.14" />
                  <sa:PremultipliedBrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
              </Border.Transitions>

              <StackPanel Spacing="0">
                <Border Name="PART_Header"
                        Cursor="Hand"
                        Padding="7,6,8,6"
                        CornerRadius="8"
                        Background="Transparent">
                  <Border.Transitions>
                    <Transitions>
                      <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.12" />
                    </Transitions>
                  </Border.Transitions>
                  <DockPanel>
                    <controls:StrataLineIcon Name="PART_Icon"
                                             DockPanel.Dock="Left"
                                             Width="14" Height="14"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Data="{x:Static controls:StrataIcons.Terminal}"
                                             Foreground="{DynamicResource Brush.TextTertiary}" />
                    <controls:StrataLineIcon Name="PART_ExpandIcon"
                                             DockPanel.Dock="Right"
                                             Width="11" Height="11"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Opacity="0"
                                             StrokeThickness="2"
                                             Data="{x:Static controls:StrataIcons.ChevronDown}"
                                             Foreground="{DynamicResource Brush.TextTertiary}"
                                             RenderTransformOrigin="50%,50%"
                                             RenderTransform="rotate(0deg)">
                      <controls:StrataLineIcon.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        </Transitions>
                      </controls:StrataLineIcon.Transitions>
                    </controls:StrataLineIcon>
                    <TextBlock Name="PART_StatusText"
                               DockPanel.Dock="Right"
                               Margin="12,0,0,0"
                               Text="{Binding GlanceText, RelativeSource={RelativeSource TemplatedParent}}"
                               IsVisible="{Binding GlanceText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Name="PART_ToolName"
                               DockPanel.Dock="Left"
                               Margin="0,0,7,0"
                               Text="{TemplateBinding ToolName}"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                    <!-- The command itself, until the console shows it in full. -->
                    <TextBlock Name="PART_CommandText"
                               Text="{TemplateBinding Command}"
                               FlowDirection="LeftToRight"
                               IsVisible="False"
                               FontFamily="{DynamicResource Font.FamilyMono}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                  </DockPanel>
                </Border>

                <!-- The console: the command, then its output scrolling beneath. -->
                <Border Name="PART_TerminalBody"
                        ClipToBounds="True"
                        IsVisible="False"
                        MaxHeight="0"
                        Opacity="0"
                        Margin="29,0,8,8"
                        CornerRadius="10"
                        BorderThickness="1"
                        Background="{DynamicResource Brush.GlassWell}"
                        BorderBrush="{DynamicResource Brush.GlassDivider}"
                        RenderTransformOrigin="0.5,0"
                        RenderTransform="translateY(-4px) scaleY(0.96)">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxHeight" Duration="0:0:0.26" Easing="CubicEaseOut" />
                      <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>

                  <StackPanel Spacing="6" Margin="11,9,11,10" FlowDirection="LeftToRight">
                    <Grid ColumnDefinitions="Auto,6,*">
                      <TextBlock Text="$"
                                 FontFamily="{DynamicResource Font.FamilyMono}"
                                 FontSize="12"
                                 Foreground="{DynamicResource Brush.TerminalPreviewPrompt}"
                                 VerticalAlignment="Top" />
                      <TextBlock Grid.Column="2"
                                 Text="{TemplateBinding Command}"
                                 FontFamily="{DynamicResource Font.FamilyMono}"
                                 FontSize="12"
                                 Foreground="{DynamicResource Brush.TerminalPreviewCommand}"
                                 TextWrapping="Wrap" />
                    </Grid>

                    <ScrollViewer Name="PART_OutputScroll"
                                  IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="260">
                      <TextBlock Name="PART_OutputText"
                                 FontFamily="{DynamicResource Font.FamilyMono}"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource Brush.TerminalPreviewOutput}"
                                 TextWrapping="Wrap"
                                 LineHeight="18" />
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:has-command:not(:expanded) /template/ TextBlock#PART_CommandText">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-output /template/ ScrollViewer#PART_OutputScroll">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ─── Hover and open: the header tints, not the console beneath it ─── -->
        <Style Selector="^ /template/ Border#PART_Header:pointerover">
          <Setter Property="Background" Value="{DynamicResource Brush.GlassRowHover}" />
        </Style>
        <Style Selector="^:pointerover /template/ TextBlock#PART_ToolName">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="^:pointerover /template/ controls|StrataLineIcon#PART_ExpandIcon">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:expanded /template/ controls|StrataLineIcon#PART_ExpandIcon">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:expanded /template/ Border#PART_TerminalBody">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="MaxHeight" Value="680" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="translateY(0) scaleY(1)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Root">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>

        <!-- ─── Running, here or in the background: the accent marks it and the time counts up ─── -->
        <Style Selector="^:inprogress /template/ controls|StrataLineIcon#PART_Icon">
          <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>
        <Style Selector="^:inprogress /template/ TextBlock#PART_ToolName">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="^:inprogress /template/ TextBlock#PART_StatusText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>

        <!-- ─── Failed: the icon and the word say so ─── -->
        <Style Selector="^:failed /template/ controls|StrataLineIcon#PART_Icon">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>
        <Style Selector="^:failed /template/ TextBlock#PART_StatusText">
          <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
