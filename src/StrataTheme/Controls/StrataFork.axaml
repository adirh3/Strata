<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataFork}" TargetType="controls:StrataFork">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="PART_FocusRing"
                      Margin="-2"
                      CornerRadius="12"
                      BorderThickness="{DynamicResource Stroke.FocusRing}"
                      BorderBrush="Transparent"
                      IsHitTestVisible="False" />

              <Border Name="PART_Root"
                      Background="{DynamicResource Brush.Surface0}"
                      BorderBrush="{DynamicResource Brush.BorderSubtle}"
                      BorderThickness="{DynamicResource Stroke.Thin}"
                      CornerRadius="{DynamicResource Radius.Interactive}"
                      ClipToBounds="True">
                <DockPanel>
                  <!-- Narrow: a segmented switch whose thumb slides between the options.
                       Wide: the same row turns into the two columns' headings. -->
                  <Border Name="PART_Header" DockPanel.Dock="Top" Padding="6,6,6,0">
                    <Border Name="PART_TabHost"
                            Background="{DynamicResource Brush.GlassWell}"
                            BorderBrush="{DynamicResource Brush.GlassDivider}"
                            CornerRadius="8"
                            Padding="3">
                      <Panel>
                        <Border Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="6"
                                Background="{DynamicResource Brush.Surface2}"
                                BorderBrush="{DynamicResource Brush.GlassRim}"
                                BorderThickness="{DynamicResource Stroke.Thin}"
                                BoxShadow="0 1 3 0 #29000000" />
                        <Grid ColumnDefinitions="*,Auto,*">
                          <Button Name="PART_OptionA" Classes="fork-tab">
                            <TextBlock Classes="fork-title" Text="{TemplateBinding OptionATitle}" />
                          </Button>
                          <Border Name="PART_HeaderGap" Grid.Column="1" Width="0" />
                          <Button Name="PART_OptionB" Grid.Column="2" Classes="fork-tab">
                            <TextBlock Classes="fork-title" Text="{TemplateBinding OptionBTitle}" />
                          </Button>
                        </Grid>
                      </Panel>
                    </Border>
                  </Border>

                  <Grid Name="PART_Body" ColumnDefinitions="*,Auto,*" Margin="16,12,16,14">
                    <ContentPresenter Name="PART_OptionAContent"
                                      Grid.ColumnSpan="3"
                                      Content="{TemplateBinding OptionAContent}" />
                    <Border Name="PART_Divider"
                            Grid.Column="1"
                            Width="1"
                            Margin="12,-12,12,-14"
                            Background="{DynamicResource Brush.GlassDivider}"
                            IsVisible="False" />
                    <ContentPresenter Name="PART_OptionBContent"
                                      Grid.ColumnSpan="3"
                                      Content="{TemplateBinding OptionBContent}"
                                      IsVisible="False" />
                  </Grid>
                </DockPanel>
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>

        <!-- ─── Tabs ─── -->
        <Style Selector="^ /template/ Button.fork-tab">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="MinHeight" Value="30" />
          <Setter Property="Padding" Value="12,5" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
          <Setter Property="Template">
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </ControlTemplate>
          </Setter>
          <Setter Property="Transitions">
            <Transitions>
              <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^ /template/ TextBlock.fork-title">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
          <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style Selector="^ /template/ Button.fork-tab:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="^:a /template/ Button#PART_OptionA">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="^:b /template/ Button#PART_OptionB">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <!-- ─── Side by side: both options at once, under their own headings ─── -->
        <Style Selector="^:split /template/ Border#PART_Header">
          <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:split /template/ Border#PART_TabHost">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="Padding" Value="16,11,16,10" />
        </Style>
        <Style Selector="^:split /template/ Border#PART_Indicator">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:split /template/ Border#PART_HeaderGap">
          <Setter Property="Width" Value="25" />
        </Style>
        <Style Selector="^:split /template/ Button.fork-tab">
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Cursor" Value="Arrow" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style Selector="^:split /template/ TextBlock.fork-title">
          <Setter Property="FontSize" Value="13.5" />
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="MaxLines" Value="2" />
        </Style>
        <Style Selector="^:split /template/ Border#PART_Divider">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:split /template/ ContentPresenter#PART_OptionAContent">
          <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>
        <Style Selector="^:split /template/ ContentPresenter#PART_OptionBContent">
          <Setter Property="Grid.Column" Value="2" />
          <Setter Property="Grid.ColumnSpan" Value="1" />
        </Style>

        <!-- ─── Focus ─── -->
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
