<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">

  <Design.PreviewWith>
    <Border Width="360" Height="420">
      <controls:StrataBottomSheet IsOpen="True" Title="Chat actions">
        <StackPanel>
          <TextBlock Text="Rename" Margin="20,14" />
          <TextBlock Text="Delete" Margin="20,14" />
        </StackPanel>
      </controls:StrataBottomSheet>
    </Border>
  </Design.PreviewWith>

  <Styles.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="{x:Type controls:StrataBottomSheet}" TargetType="controls:StrataBottomSheet">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel Name="PART_Root">
              <!-- Scrim: dims the page and gives a huge, imprecise dismiss target. -->
              <Border Name="PART_Scrim"
                      Background="#99000000"
                      Opacity="0"
                      IsHitTestVisible="False">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
              </Border>

              <Border Name="PART_SheetMotion"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Stretch"
                      Margin="{TemplateBinding SheetMargin}"
                      RenderTransformOrigin="0.5,1"
                      Opacity="0">
                <Border Name="PART_Sheet"
                        Background="{DynamicResource Brush.Surface1}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="20,20,0,0"
                        BoxShadow="0 -8 32 0 #50000000"
                        ClipToBounds="True">
                  <DockPanel LastChildFill="True">
                  <!-- The grip and title share a touch-sized drag surface. -->
                  <Border Name="PART_Handle"
                          DockPanel.Dock="Top"
                          Background="Transparent"
                          MinHeight="48"
                          Cursor="Hand">
                    <StackPanel>
                      <Border Width="32" Height="4" CornerRadius="2" Margin="0,12,0,12"
                              HorizontalAlignment="Center"
                              Background="{DynamicResource Brush.BorderStrong}" />

                      <TextBlock Name="PART_Title"
                                 Text="{TemplateBinding Title}"
                                 Margin="20,0,20,14"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.TextTertiary}"
                                 IsVisible="{TemplateBinding Title,
                                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                    <ContentPresenter Name="PART_ContentPresenter"
                                      IsVisible="False"
                                      Margin="0,0,0,10"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </DockPanel>
                </Border>
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:open">
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="^:open /template/ Border#PART_Scrim">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Full-width rows: a sheet's actions are thumb targets, not menu items. -->
  <Style Selector="controls|StrataBottomSheet Button.sheet-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20,15" />
    <Setter Property="MinHeight" Value="54" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style Selector="controls|StrataBottomSheet Button.sheet-item:pressed">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>

  <Style Selector="controls|StrataBottomSheet Button.sheet-item.danger">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>

</Styles>
