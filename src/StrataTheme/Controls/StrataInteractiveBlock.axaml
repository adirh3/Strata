  <Style Selector="controls|StrataInteractiveBlock Border.explorer-segmented">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <!-- Segments fill the toolbar row, so the switch stands as tall as the buttons beside it. -->
  <Style Selector="controls|StrataInteractiveBlock RadioButton.explorer-segment">
    <Setter Property="Width" Value="34" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Panel>
          <Border Name="PART_FocusRing" Margin="-2" CornerRadius="8" BorderThickness="{DynamicResource Stroke.FocusRing}"
                  BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Segment" CornerRadius="6" Background="Transparent">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.explorer-segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.explorer-segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.explorer-segment:checked /template/ Border#PART_Segment">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface0}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #24000000" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.explorer-segment:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>

