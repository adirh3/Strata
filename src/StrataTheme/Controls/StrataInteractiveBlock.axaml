<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type controls:StrataInteractiveBlock}"
                  TargetType="controls:StrataInteractiveBlock">
      <!-- Left (start in RTL), not Stretch: a Stretch element capped by MaxWidth is centered in wider columns. -->
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="720" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Card"
                  Background="{DynamicResource Brush.Surface0}"
                  BorderBrush="{DynamicResource Brush.BorderSubtle}"
                  BorderThickness="{DynamicResource Stroke.Thin}"
                  CornerRadius="{DynamicResource Radius.Interactive}"
                  ClipToBounds="True">
            <Panel>
              <Border Name="PART_Stratum" Height="2" VerticalAlignment="Top" IsVisible="False"
                      Background="{DynamicResource Brush.AccentGradient}" />
              <StackPanel Name="PART_Layout" Margin="16,14" Spacing="14">
                <Grid Name="PART_Header" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Name="PART_IconTile" Classes="interactive-tile" VerticalAlignment="Top">
                    <PathIcon FlowDirection="LeftToRight" Name="PART_Icon" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Name="PART_Title" Classes="interactive-title" />
                    <TextBlock Name="PART_Description" Classes="interactive-description" />
                  </StackPanel>
                  <ContentControl Grid.Column="2" Name="PART_Meta" VerticalAlignment="Top" Margin="0,5,0,0" />
                </Grid>
                <StackPanel Name="PART_Body" Spacing="12" />
                <Grid Name="PART_ErrorRow" ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="False">
                  <PathIcon FlowDirection="LeftToRight" Width="13" Height="13" Margin="0,1,0,0" VerticalAlignment="Top"
                            Foreground="{DynamicResource Brush.DangerDefault}"
                            Data="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z" />
                  <TextBlock Grid.Column="1" Name="PART_Error" Classes="interactive-error" />
                </Grid>
                <Grid Name="PART_Footer" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <WrapPanel Name="PART_Actions" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Name="PART_Status" Classes="interactive-status" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:waiting /template/ Border#PART_Stratum">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:waiting /template/ Border#PART_Card">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
      </Style>
      <Style Selector="^.touch /template/ StackPanel#PART_Layout">
        <Setter Property="Margin" Value="14,14" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- ── Header ── -->
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-tile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Base}" />
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-tile PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-tile.success">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-tile.success PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-tile.muted">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-tile.muted PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>

  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill.accent">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill.accent Ellipse">
    <Setter Property="Fill" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-pill.success PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>

  <!-- ── Typography ── -->
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-title">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-description">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-body">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-strong">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-label">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-detail">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-hint">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-error">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-status">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-required">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>

  <!-- ── Actions ── -->
  <Style Selector="controls|StrataInteractiveBlock WrapPanel#PART_Actions Button">
    <Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeightM}" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock WrapPanel#PART_Actions Button PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock WrapPanel#PART_Actions Button.subtle">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock WrapPanel#PART_Actions Button.subtle TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock WrapPanel#PART_Actions Button.subtle:pointerover TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock WrapPanel#PART_Actions Button.accent PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>

  <!-- ── Form fields ── -->
  <Style Selector="controls|StrataInteractiveBlock Control.interactive-input">
    <Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeightM}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock NumericUpDown.interactive-input">
    <Setter Property="ShowButtonSpinner" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock NumericUpDown.interactive-input /template/ TextBox#PART_TextBox">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-adornment">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBox.interactive-invalid /template/ Border#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderError}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock NumericUpDown.interactive-invalid /template/ ButtonSpinner#PART_Spinner /template/ Border#border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderError}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock ComboBox.interactive-invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderError}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-field.interactive-invalid /template/ Border#PART_Field">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderError}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock WrapPanel.interactive-invalid :is(ToggleButton).interactive-chip /template/ Border#PART_Chip">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderError}" />
  </Style>

  <!-- Input-styled button for dates and touch pickers. -->
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-field">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel>
          <Border Name="PART_FocusRing" Margin="-2" CornerRadius="{DynamicResource Radius.Base}"
                  BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Field" Background="{DynamicResource Brush.ControlDefault}"
                  BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="{DynamicResource Stroke.Thin}"
                  CornerRadius="{DynamicResource Radius.Base}" Padding="12,0" MinHeight="{TemplateBinding MinHeight}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                              HorizontalContentAlignment="Stretch" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-field:pointerover /template/ Border#PART_Field">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-field:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-field PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-field TextBlock.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>

  <!-- Chips: multi-select (ToggleButton) and single-select (RadioButton). -->
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleButton">
        <Panel>
          <Border Name="PART_FocusRing" Margin="-2" CornerRadius="{DynamicResource Radius.Full}"
                  BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Chip" Background="{DynamicResource Brush.ControlDefault}"
                  BorderBrush="{DynamicResource Brush.BorderDefault}" BorderThickness="{DynamicResource Stroke.Thin}"
                  CornerRadius="{DynamicResource Radius.Full}" Padding="12,0" MinHeight="{TemplateBinding MinHeight}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon FlowDirection="LeftToRight" Name="PART_Check" Width="10" Height="10" IsVisible="False"
                        Foreground="{DynamicResource Brush.AccentDefault}"
                        Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip:pointerover /template/ Border#PART_Chip">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip:checked /template/ Border#PART_Chip">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip:checked">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip.multi:checked /template/ PathIcon#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock :is(ToggleButton).interactive-chip:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- ── Checklist rows ── -->
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Panel>
          <Border Name="PART_FocusRing" CornerRadius="{DynamicResource Radius.Base}"
                  BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Row" Background="Transparent" CornerRadius="{DynamicResource Radius.Base}" Padding="8,8">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,0,0">
                <Border Name="PART_Indicator" CornerRadius="10" BorderThickness="1.5"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" Background="Transparent">
                  <Border.Transitions>
                    <Transitions>
                      <BrushTransition Property="Background" Duration="0:0:0.15" />
                      <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
                <TextBlock Name="PART_Number" Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <PathIcon FlowDirection="LeftToRight" Name="PART_Check" Width="11" Height="11" IsVisible="False"
                          Foreground="{DynamicResource Brush.TextOnAccent}"
                          Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </Panel>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:pointerover /template/ Border#PART_Row">
    <Setter Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:pointerover /template/ Border#PART_Indicator">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row.current /template/ Border#PART_Indicator">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row.current /template/ TextBlock#PART_Number">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:checked /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:checked /template/ PathIcon#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:checked /template/ TextBlock#PART_Number">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:checked TextBlock.interactive-row-title">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row:checked TextBlock.interactive-detail">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-row.current TextBlock.interactive-row-title">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-row-title">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-meta">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- ── Choice cards ── -->
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="CheckBox">
        <Panel>
          <Border Name="PART_FocusRing" Margin="-2" CornerRadius="{DynamicResource Radius.Interactive}"
                  BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Card" Background="{DynamicResource Brush.Surface1}"
                  BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="{DynamicResource Stroke.Thin}"
                  CornerRadius="{DynamicResource Radius.Interactive}" Padding="14,12">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
              <Panel Grid.Column="1" Width="20" Height="20" VerticalAlignment="Top">
                <Border Name="PART_Indicator" CornerRadius="10" BorderThickness="1.5"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" Background="Transparent" />
                <PathIcon FlowDirection="LeftToRight" Name="PART_Check" Width="11" Height="11" IsVisible="False"
                          Foreground="{DynamicResource Brush.TextOnAccent}"
                          Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </Panel>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card:pointerover /template/ Border#PART_Card">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card:checked /template/ Border#PART_Card">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card:checked /template/ Border#PART_Indicator">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card:checked /template/ PathIcon#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock CheckBox.interactive-card:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- ── Practice options ── -->
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Panel>
          <Border Name="PART_FocusRing" Margin="-2" CornerRadius="{DynamicResource Radius.Interactive}"
                  BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Option" Background="{DynamicResource Brush.Surface1}"
                  BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="{DynamicResource Stroke.Thin}"
                  CornerRadius="{DynamicResource Radius.Interactive}" Padding="12,10">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Panel Width="24" Height="24" VerticalAlignment="Top">
                <Border Name="PART_Badge" CornerRadius="12" BorderThickness="1.5"
                        BorderBrush="{DynamicResource Brush.BorderStrong}" Background="Transparent" />
                <TextBlock Name="PART_Letter" Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <PathIcon FlowDirection="LeftToRight" Name="PART_Correct" Width="12" Height="12" IsVisible="False"
                          Foreground="{DynamicResource Brush.TextOnAccent}"
                          Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                <PathIcon FlowDirection="LeftToRight" Name="PART_Incorrect" Width="10" Height="10" IsVisible="False"
                          Foreground="{DynamicResource Brush.TextOnDanger}"
                          Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
              </Panel>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option:pointerover /template/ Border#PART_Option">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option:checked /template/ Border#PART_Option">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGlowSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option:checked /template/ Border#PART_Badge">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option:checked /template/ TextBlock#PART_Letter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.correct /template/ Border#PART_Option">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.correct /template/ Border#PART_Badge">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.correct /template/ PathIcon#PART_Correct">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.incorrect /template/ Border#PART_Option">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.incorrect /template/ Border#PART_Badge">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.incorrect /template/ PathIcon#PART_Incorrect">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.correct /template/ TextBlock#PART_Letter, controls|StrataInteractiveBlock RadioButton.interactive-option.incorrect /template/ TextBlock#PART_Letter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option.dimmed">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock RadioButton.interactive-option:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentGradient}" />
  </Style>

  <!-- ── Panels, callouts and data ── -->
  <Style Selector="controls|StrataInteractiveBlock Ellipse.interactive-ring-track">
    <Setter Property="Stroke" Value="{DynamicResource Brush.BorderDefault}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Arc.interactive-ring">
    <Setter Property="Stroke" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Arc.interactive-ring.done">
    <Setter Property="Stroke" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock PathIcon.interactive-adornment-icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.chart1">
    <Setter Property="Background" Value="{DynamicResource Brush.Chart1}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.chart4">
    <Setter Property="Background" Value="{DynamicResource Brush.Chart4}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.chart6">
    <Setter Property="Background" Value="{DynamicResource Brush.Chart6}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.chart-rest">
    <Setter Property="Background" Value="{DynamicResource Brush.BorderDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-question">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeSubtitle}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Interactive}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Interactive}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout.success PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout.success TextBlock.interactive-strong">
    <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout.danger PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout.danger TextBlock.interactive-strong">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-callout.hint PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.WarningDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-hero">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeHeadline}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-hero.negative">
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-stat">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-track">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-segment">
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
    <Setter Property="Background" Value="{DynamicResource Brush.BorderDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-segment.current">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-segment.correct">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Border.interactive-segment.incorrect">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerDefault}" />
  </Style>

  <!-- ── Frozen snapshot lists ── -->
  <Style Selector="controls|StrataInteractiveBlock TextBlock.interactive-snapshot-key">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock SelectableTextBlock.interactive-snapshot-value">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock SelectableTextBlock.interactive-snapshot-title">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock SelectableTextBlock.interactive-snapshot-text">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-disclosure">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="-6,0,0,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-disclosure PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.interactive-disclosure TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>

  <!-- ── Touch ── -->
  <Style Selector="controls|StrataInteractiveBlock.touch Button, controls|StrataInteractiveBlock.touch :is(ToggleButton).interactive-chip, controls|StrataInteractiveBlock.touch TextBox.interactive-input, controls|StrataInteractiveBlock.touch NumericUpDown.interactive-input">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock.touch WrapPanel#PART_Actions Button">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock.touch CheckBox.interactive-row /template/ Border#PART_Row">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="8,12" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock.touch CheckBox.interactive-card, controls|StrataInteractiveBlock.touch RadioButton.interactive-option">
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock.touch Button.interactive-disclosure">
    <Setter Property="MinHeight" Value="48" />
  </Style>
</Styles>
