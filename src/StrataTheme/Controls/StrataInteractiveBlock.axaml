  <!-- ── Option explorer ── -->
  <!-- Toolbar -->
  <Style Selector="controls|StrataInteractiveBlock Button.explorer-tool">
    <Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeightM}" />
    <!-- A narrow row's sort is only its icon; it stays a square target. -->
    <Setter Property="MinWidth" Value="{DynamicResource Size.ControlHeightM}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataInteractiveBlock Button.explorer-tool:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
