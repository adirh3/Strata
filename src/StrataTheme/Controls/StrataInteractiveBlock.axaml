        <Panel>
          <Border Name="PART_FocusRing" Margin="-2" CornerRadius="{DynamicResource Radius.Full}"
                  BorderThickness="{DynamicResource Stroke.FocusRing}" BorderBrush="Transparent" IsHitTestVisible="False" />
          <Border Name="PART_Chip" CornerRadius="{DynamicResource Radius.Full}" Padding="10,0"
                  Background="{DynamicResource Brush.AccentGlowSoft}" MinHeight="{TemplateBinding MinHeight}">
            <Border.Transitions>
