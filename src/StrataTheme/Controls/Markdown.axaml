<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StrataTheme.Controls">

  <!-- Default text color for all markdown content (inherited by children) -->
  <Style Selector="controls|StrataMarkdown">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- Renderer helpers belong to their markdown tree, not every control in the application.
       Image-viewer helpers stay global because the full-screen overlay is hosted separately. -->
  <Style Selector=":is(controls|StrataMarkdown) TextBlock.strata-md-title">
    <Setter Property="FontSize" Value="{DynamicResource Font.SizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    <Setter Property="Margin" Value="2,0,0,0" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-bullet-dot">
    <Setter Property="Background" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-hr">
    <Setter Property="Background" Value="{DynamicResource Brush.BorderSubtle}" />
  </Style>

  <!-- Blockquote: left accent bar with subtle background -->
  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-blockquote">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="12,6,8,6" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) TextBlock.strata-md-link-text">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-image">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-image:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-image-expand, Button.strata-md-image-viewer-close, Button.strata-md-image-viewer-action">
    <Setter Property="Width" Value="{DynamicResource Size.ControlHeightS}" />
    <Setter Property="Height" Value="{DynamicResource Size.ControlHeightS}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Thin}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-image-expand">
    <Setter Property="Margin" Value="6" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-image-expand:pointerover, :is(controls|StrataMarkdown) Button.strata-md-image-expand:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBlock.strata-md-image-caption">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) TextBlock.strata-md-image-placeholder">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector="ProgressBar.strata-md-image-progress">
    <Setter Property="Width" Value="88" />
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0,12,10" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Image.strata-md-image-content">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-link:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-link:pointerover /template/ Border#PART_Aurora">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-link:pointerover TextBlock.strata-md-link-text">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHover}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-link:focus-visible">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) TextBlock.strata-md-code-text">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>
  <Style Selector=":is(controls|StrataMarkdown) SelectableTextBlock.strata-md-code-text">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-inline-code">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-inline-code TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-surface">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-surface:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-surface-inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-code-block">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) :is(Border).strata-md-table">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-table-copy-button">
    <Setter Property="Opacity" Value="0.68" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-table-copy-button TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-table:pointerover Button.strata-md-table-copy-button">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Button.strata-md-table-copy-button:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-table:pointerover Button.strata-md-table-copy-button TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-table-header-cell">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) Border.strata-md-table-cell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) TextBlock.strata-md-code-lang">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>

  <Style Selector="Border.CodeBlock">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,10,0,10" />
  </Style>

  <Style Selector="TextBlock.CodeBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
  </Style>

  <!-- StrataCodeBlock: syntax-highlighted code display -->
  <Style Selector=":is(controls|StrataMarkdown) controls|StrataCodeBlock.strata-md-code-editor > SelectableTextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.FamilyMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
  </Style>

  <!-- Horizontal scrollbar within the code block ScrollViewer -->
  <Style Selector=":is(controls|StrataMarkdown) ScrollViewer.strata-md-code-scroll ScrollBar:horizontal">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="Height" Value="7" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) ScrollViewer.strata-md-code-scroll ScrollBar:horizontal /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.BorderStrong}" />
  </Style>

  <Style Selector=":is(controls|StrataMarkdown) ScrollViewer.strata-md-code-scroll ScrollBar:horizontal:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
  </Style>

</Styles>
