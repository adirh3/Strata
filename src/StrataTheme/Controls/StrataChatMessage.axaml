<Styles xmlns="https://github.com/avaloniaui"
        xmlns:sa="using:StrataTheme.Animation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StrataTheme.Controls">

  <!-- ═══════════════════════════════════════════════════════════════
       StrataChatMessage
       Text-first message layout with inline edit support.
       Finished assistant answers end with a quiet footer: icon actions,
       then the author/model caption and time, wrapping on narrow widths.
       Edit mode swaps content for a TextBox with Save/Cancel.
       CanReply adds a Reply action beside the meta row, a Reply
       context-menu item, and a floating Reply pill over selected text.
       ═══════════════════════════════════════════════════════════════ -->

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Message action icons: 16px outline glyphs stroked in the owning button's foreground. -->
      <StreamGeometry x:Key="Icon.MessageCopy">M3.5 10A1.5 1.5 0 0 1 2 8.5V3.5A1.5 1.5 0 0 1 3.5 2H8.5A1.5 1.5 0 0 1 10 3.5M7.5 6H12.5A1.5 1.5 0 0 1 14 7.5V12.5A1.5 1.5 0 0 1 12.5 14H7.5A1.5 1.5 0 0 1 6 12.5V7.5A1.5 1.5 0 0 1 7.5 6Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.MessageCopied">M3 8.5L6.5 12L13 4.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.MessageReply">M6 3.5L2.5 7L6 10.5M2.5 7H9.5A4 4 0 0 1 13.5 11V12.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.MessageShare">M8 10V2.5M5 5.5L8 2.5L11 5.5M3 8.5V12A2 2 0 0 0 5 14H11A2 2 0 0 0 13 12V8.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.MessageEdit">M10.5 3L13 5.5L5.75 12.75L2.5 13.5L3.25 10.25ZM9 4.5L11.5 7</StreamGeometry>
      <StreamGeometry x:Key="Icon.MessageRetry">M13.25 8A5.25 5.25 0 1 1 11.71 4.29L13.25 5.75M13.25 2.5V5.75H10</StreamGeometry>
      <StreamGeometry x:Key="Icon.MessageMore">M2.8 8A0.7 0.7 0 1 0 4.2 8A0.7 0.7 0 1 0 2.8 8ZM7.3 8A0.7 0.7 0 1 0 8.7 8A0.7 0.7 0 1 0 7.3 8ZM11.8 8A0.7 0.7 0 1 0 13.2 8A0.7 0.7 0 1 0 11.8 8Z</StreamGeometry>

      <ControlTheme x:Key="{x:Type controls:StrataChatMessage}" TargetType="controls:StrataChatMessage">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Name="PART_Root" Spacing="0" Background="Transparent">

              <WrapPanel Name="PART_HeaderRow" Orientation="Horizontal" Margin="0,0,0,2">
                <WrapPanel.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
                  </Transitions>
                </WrapPanel.Transitions>
                <Grid Name="PART_MetaRow" IsVisible="False" ColumnDefinitions="Auto,Auto,*"
                      VerticalAlignment="Center">
                  <TextBlock Name="PART_Author" Grid.Column="0" Text="{TemplateBinding Author}"
                             MaxWidth="240" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{TemplateBinding Author}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                  <TextBlock Name="PART_MetaSeparator" Grid.Column="1" Text="·" Margin="6,0"
                             IsVisible="False"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                  <TextBlock Name="PART_Timestamp" Grid.Column="2" Text="{TemplateBinding Timestamp}"
                             ToolTip.Tip="{TemplateBinding TimestampToolTip}"
                             ToolTip.ShowDelay="350"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                </Grid>
              </WrapPanel>

              <!-- Read mode: content + side action bar -->
              <Grid Name="PART_BubbleRow" ColumnDefinitions="Auto,*,Auto">
                <Border Name="PART_Bubble"
                        Grid.Column="1"
                        Background="Transparent"
                        Padding="0,6,0,4"
                        RenderTransformOrigin="0.5,0.5"
                        RenderTransform="scale(1)">
                  <Border.Transitions>
                    <Transitions>
                      <sa:PremultipliedBrushTransition Property="Background" Duration="0:0:0.14" />
                      <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                      <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                    </Transitions>
                  </Border.Transitions>
                  <!-- TextBlock.TextWrapping is inherited by the TextBlock the presenter creates
                       for plain-string Content. Without it a message set as a raw string renders
                       on one line and is clipped by the bubble's MaxWidth, which is exactly what a
                       chat bubble must never do. Rich content supplies its own wrapping. -->
                  <ContentPresenter Content="{TemplateBinding Content}"
                                    TextBlock.TextWrapping="Wrap" />
                </Border>

                <!-- Assistant actions move into the metadata footer; user actions remain beside the bubble. -->
                <Border Name="PART_ActionLayer"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0"
                        IsHitTestVisible="False"
                        RenderTransform="translateX(8px)"
                        Margin="6,0,0,0">
                  <StackPanel Name="PART_ActionBar"
                              Orientation="Horizontal"
                              Spacing="0">
                    <Border Name="PART_ActionSurface" Background="{DynamicResource Brush.Surface1}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2,1">
                      <StackPanel Name="PART_ActionButtons" Orientation="Horizontal" Spacing="0">
                        <Button Name="PART_CopyButton" Classes="subtle strata-message-action"
                                Padding="8,3" MinHeight="22" MinWidth="0" CornerRadius="4"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                ToolTip.Tip="{TemplateBinding CopyLabel}"
                                AutomationProperties.Name="{TemplateBinding CopyLabel}">
                          <Panel>
                            <Path Name="PART_CopyIcon" Classes="strata-message-icon"
                                  Data="{DynamicResource Icon.MessageCopy}" />
                            <Path Name="PART_CopiedIcon" Classes="strata-message-icon"
                                  Data="{DynamicResource Icon.MessageCopied}" />
                            <TextBlock Classes="strata-message-label" Text="{TemplateBinding CopyLabel}" FontSize="11" />
                          </Panel>
                        </Button>
                        <Button Name="PART_ReplyButton" Classes="subtle strata-message-action"
                                IsVisible="False" Padding="8,3" MinHeight="22" MinWidth="0" CornerRadius="4"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                ToolTip.Tip="{TemplateBinding ReplyLabel}"
                                AutomationProperties.Name="{TemplateBinding ReplyLabel}">
                          <Panel>
                            <Path Classes="strata-message-icon" Data="{DynamicResource Icon.MessageReply}" />
                            <TextBlock Classes="strata-message-label" Text="{TemplateBinding ReplyLabel}" FontSize="11" />
                          </Panel>
                        </Button>
                        <Button Name="PART_ShareButton" Classes="subtle strata-message-action"
                                IsVisible="False" Padding="8,3" MinHeight="22" MinWidth="0" CornerRadius="4"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                ToolTip.Tip="{TemplateBinding ShareLabel}"
                                AutomationProperties.Name="{TemplateBinding ShareLabel}">
                          <Panel>
                            <Path Classes="strata-message-icon" Data="{DynamicResource Icon.MessageShare}" />
                            <TextBlock Classes="strata-message-label" Text="{TemplateBinding ShareLabel}" FontSize="11" />
                          </Panel>
                        </Button>
                        <Border Name="PART_EditSep" Width="1" Margin="2,3"
                                Background="{DynamicResource Brush.BorderSubtle}" />
                        <Button Name="PART_EditButton" Classes="subtle strata-message-action"
                                Padding="8,3" MinHeight="22" MinWidth="0" CornerRadius="4"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                ToolTip.Tip="Edit" AutomationProperties.Name="Edit">
                          <Panel>
                            <Path Classes="strata-message-icon" Data="{DynamicResource Icon.MessageEdit}" />
                            <TextBlock Classes="strata-message-label" Text="Edit" FontSize="11" />
                          </Panel>
                        </Button>
                        <Border Name="PART_RegenerateSep" Width="1" Margin="2,3"
                                Background="{DynamicResource Brush.BorderSubtle}" />
                        <Button Name="PART_RegenerateButton" Classes="subtle strata-message-action"
                                Padding="8,3" MinHeight="22" MinWidth="0" CornerRadius="4"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                ToolTip.Tip="Retry" AutomationProperties.Name="Retry">
                          <Panel>
                            <Path Classes="strata-message-icon" Data="{DynamicResource Icon.MessageRetry}" />
                            <TextBlock Classes="strata-message-label" Text="Retry" FontSize="11" />
                          </Panel>
                        </Button>
                        <Button Name="PART_MoreButton" Classes="subtle strata-message-action"
                                IsVisible="False" Padding="8,3" MinHeight="22" MinWidth="0" CornerRadius="4"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                ToolTip.Tip="{TemplateBinding MoreActionsLabel}"
                                AutomationProperties.Name="{TemplateBinding MoreActionsLabel}">
                          <Path Classes="strata-message-icon" Data="{DynamicResource Icon.MessageMore}" />
                        </Button>
                      </StackPanel>
                    </Border>

                    <TextBlock Name="PART_StatusText"
                               IsVisible="False"
                               Text="{TemplateBinding StatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Edit mode: TextBox with save/cancel -->
              <Border Name="PART_EditArea"
                      IsVisible="False"
                      Background="{DynamicResource Brush.Surface1}"
                      BorderBrush="{DynamicResource Brush.BorderSubtle}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="4"
                      Opacity="0"
                      RenderTransformOrigin="0.5,0"
                      RenderTransform="translateY(-4px)">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                  </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="0">
                  <TextBox Name="PART_EditBox"
                           Classes="message-edit-embed no-focus-accent"
                           Text="{Binding EditText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="40" MaxHeight="400"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="10,8"
                           FontSize="13"
                           FontFamily="{DynamicResource Font.Default}" />
                  <DockPanel Margin="6,2,6,4">
                    <TextBlock Name="PART_EditHint"
                               DockPanel.Dock="Left"
                               FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               Text="Enter to save · Esc to cancel · Shift+Enter for newline" />
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right">
                      <Button Name="PART_CancelButton" Classes="subtle"
                              Padding="10,4" MinHeight="0" CornerRadius="6"
                              FontSize="11" ToolTip.Tip="Cancel (Esc)">
                        <TextBlock Text="Cancel"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                      </Button>
                      <Button Name="PART_SaveButton" Classes="accent"
                              Padding="10,4" MinHeight="0" CornerRadius="6"
                              FontSize="11" FontWeight="SemiBold"
                              ToolTip.Tip="Save (Enter)">
                        <TextBlock Text="Save" />
                      </Button>
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>

              <DockPanel Name="PART_FooterRow"
                         IsVisible="False"
                         Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Border Name="PART_FooterDot"
                          Width="5" Height="5" CornerRadius="2.5"
                          Background="{DynamicResource Brush.TextTertiary}"
                          VerticalAlignment="Center" />
                  <TextBlock Name="PART_FooterStatus"
                             Text="{TemplateBinding StatusText}"
                             FontSize="11"
                             Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
              </DockPanel>

              <!-- Streaming accent line -->
              <Border Name="PART_StreamBar"
                      Height="2" CornerRadius="1"
                      Background="{DynamicResource Brush.AccentGradient}"
                      HorizontalAlignment="Left"
                      Width="60" Opacity="0"
                      Margin="0,2,0,0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                  </Transitions>
                </Border.Transitions>
              </Border>

            </StackPanel>
          </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Bubble:pointerover">
          <Setter Property="BoxShadow" Value="0 1 6 0 #14000000" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Bubble">
          <Setter Property="RenderTransform" Value="scale(0.995)" />
        </Style>

        <!-- During active shell scrolling, suppress hover chrome to keep scroll smooth. -->
        <Style Selector="^:host-scrolling /template/ Border#PART_Bubble:pointerover">
          <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <!-- Meta + status visibility -->
        <Style Selector="^:has-meta /template/ Grid#PART_MetaRow">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-author:has-timestamp /template/ TextBlock#PART_MetaSeparator">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Reply is opt-in and accented while the host composes a reply to this message. -->
        <Style Selector="^:can-reply /template/ Button#PART_ReplyButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:can-reply:editing /template/ Button#PART_ReplyButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:can-share /template/ Button#PART_ShareButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:streaming /template/ Button#PART_ShareButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:editing /template/ Button#PART_ShareButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:system /template/ Button#PART_ShareButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:assistant:has-status /template/ DockPanel#PART_FooterRow">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:assistant:has-status /template/ Border#PART_FooterDot">
          <Setter Property="Background" Value="{DynamicResource Brush.SuccessDefault}" />
        </Style>
        <Style Selector="^:tool:has-status /template/ DockPanel#PART_FooterRow">
          <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- ── Edit mode: show edit area, hide content + action bar ── -->
        <Style Selector="^:editing /template/ Border#PART_Bubble">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:editing /template/ Border#PART_EditArea">
          <Setter Property="IsVisible" Value="True" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="translateY(0)" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDefault}" />
        </Style>
        <Style Selector="^:editing /template/ Border#PART_StreamBar">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:editing /template/ DockPanel#PART_FooterRow">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Hide Edit button when not editable -->
        <Style Selector="^:not(:editable) /template/ Button#PART_EditButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:editable) /template/ Border#PART_EditSep">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:user /template/ Border#PART_RegenerateSep">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:streaming /template/ Border#PART_RegenerateSep">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ══ Message actions ══ -->
        <!-- Outline icons follow the owning button's foreground; assistant footers show them instead of labels. -->
        <Style Selector="^ /template/ Path.strata-message-icon">
          <Setter Property="IsVisible" Value="False" />
          <Setter Property="Width" Value="16" />
          <Setter Property="Height" Value="16" />
          <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
          <Setter Property="StrokeThickness" Value="1.4" />
          <Setter Property="StrokeLineCap" Value="Round" />
          <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="^ /template/ Button.strata-message-action:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <!-- ══ ASSISTANT ══ -->
        <Style Selector="^:assistant /template/ Border#PART_Bubble">
          <Setter Property="Padding" Value="0,6,0,4" />
        </Style>
        <Style Selector="^:assistant /template/ WrapPanel#PART_HeaderRow">
          <Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeightS}" />
          <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- The footer belongs to the finished answer and fades in once streaming ends. -->
        <Style Selector="^:assistant:streaming /template/ WrapPanel#PART_HeaderRow">
          <Setter Property="IsVisible" Value="False" />
          <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Actions lead the footer. The message clips to its bounds, so the 2px inset keeps the first
             button's hover surface and focus ring (drawn 2px outside it) whole at the answer's edge. -->
        <Style Selector="^:assistant /template/ Border#PART_ActionLayer">
          <Setter Property="Margin" Value="2,0,10,0" />
          <Setter Property="RenderTransform" Value="translateX(0)" />
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="^:assistant /template/ Border#PART_ActionSurface">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:assistant /template/ StackPanel#PART_ActionButtons">
          <Setter Property="Spacing" Value="2" />
        </Style>
        <Style Selector="^:assistant /template/ Button.strata-message-action">
          <Setter Property="Width" Value="{DynamicResource Size.ControlHeightS}" />
          <Setter Property="Height" Value="{DynamicResource Size.ControlHeightS}" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="{DynamicResource Radius.Base}" />
        </Style>
        <Style Selector="^:assistant /template/ Path.strata-message-icon,
                         ^:assistant /template/ Button#PART_MoreButton">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:assistant /template/ TextBlock.strata-message-label,
                         ^:assistant:copied /template/ Path#PART_CopyIcon,
                         ^:assistant:not(:copied) /template/ Path#PART_CopiedIcon">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:assistant:copied /template/ Button#PART_CopyButton">
          <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessDefault}" />
        </Style>
        <Style Selector="^:copied /template/ Button#PART_CopyButton">
          <Setter Property="ToolTip.Tip" Value="{Binding CopiedLabel, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>

        <!-- ══ PROGRESS UPDATE: narration written while working never carries the answer's footer ══ -->
        <Style Selector="^:assistant:progress-update /template/ WrapPanel#PART_HeaderRow">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Folded into a turn summary with the work it narrates, an update reads quieter; outside one it keeps the answer's voice. -->
        <Style Selector="^:assistant:progress-update[(controls|StrataTurnSummary.IsWithinSummary)=True] /template/ Border#PART_Bubble">
          <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
          <Setter Property="controls:StrataChatMessage.IsWithinQuietUpdate" Value="True" />
        </Style>

        <!-- ══ USER: right-aligned subtle pill ══ -->
        <Style Selector="^:user">
          <Setter Property="Foreground" Value="{DynamicResource Brush.ChatUserBubbleText}" />
        </Style>
        <Style Selector="^:user /template/ Border#PART_Bubble">
          <Setter Property="Background" Value="{DynamicResource Brush.ChatUserBubble}" />
          <Setter Property="CornerRadius" Value="14" />
          <Setter Property="Padding" Value="16,10,16,10" />
          <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^:user /template/ WrapPanel#PART_HeaderRow">
          <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^:user /template/ Grid#PART_MetaRow TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style Selector="^:user /template/ Border#PART_ActionLayer">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Margin" Value="0,0,6,0" />
          <Setter Property="RenderTransform" Value="translateX(-8px)" />
        </Style>
        <Style Selector="^:user /template/ Button#PART_RegenerateButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ══ SYSTEM ══ -->
        <Style Selector="^:system /template/ Border#PART_Bubble">
          <Setter Property="Padding" Value="0,4,0,4" />
        </Style>
        <Style Selector="^:system /template/ Border#PART_ActionLayer">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ══ TOOL ══ -->
        <Style Selector="^:tool /template/ Border#PART_Bubble">
          <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ══ STREAMING ══ -->
        <Style Selector="^:streaming /template/ Border#PART_StreamBar">
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:streaming /template/ Button#PART_RegenerateButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ══ Action bar slide-in (after role styles for correct precedence) ══ -->
        <!-- Only hover toolbars animate; the assistant footer is static chrome and must not replay
             an entrance whenever a message is created or realized. -->
        <Style Selector="^:not(:assistant) /template/ Border#PART_ActionLayer">
          <Setter Property="Transitions">
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
          </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_ActionLayer">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
          <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_ActionLayer">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
          <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>
        <!-- Touch has no hover: a tap sets :actions-revealed so the bar is reachable by finger. -->
        <Style Selector="^:actions-revealed /template/ Border#PART_ActionLayer">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
          <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>
        <Style Selector="^:menu-open /template/ Border#PART_ActionLayer,
                         ^:reply-source /template/ Border#PART_ActionLayer">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="IsHitTestVisible" Value="True" />
          <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>
        <!-- Hover toolbars stand down while the shell scrolls; the assistant footer stays put. -->
        <Style Selector="^:host-scrolling:not(:assistant) /template/ Border#PART_ActionLayer">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:editing /template/ Border#PART_ActionLayer">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ══ Focus ══ -->
        <Style Selector="^:focus-visible /template/ Border#PART_Bubble">
          <Setter Property="BoxShadow" Value="0 0 0 2 #30818CF8" />
          <Setter Property="CornerRadius" Value="6" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Embedded edit TextBox chrome removal (regular styles, outside ControlTheme) -->

  <!-- User bubble: override markdown text color so it contrasts with the indigo background -->
  <Style Selector="controls|StrataChatMessage:user controls|StrataMarkdown">
    <Setter Property="Foreground" Value="{DynamicResource Brush.ChatUserBubbleText}" />
  </Style>
  <!-- Quiet progress update: markdown sets its own text colour, so it takes the quieter voice here too. It
       matches on the inherited flag, not on the message as an ancestor: a host can attach content
       before it joins the message's logical tree, and the ancestor match would then never apply. -->
  <Style Selector="controls|StrataMarkdown[(controls|StrataChatMessage.IsWithinQuietUpdate)=True]">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="controls|StrataChatMessage:user Border.strata-md-bullet-dot">
    <Setter Property="Background" Value="{DynamicResource Brush.ChatUserBubbleText}" />
  </Style>
  <!-- User bubble: override text selection color for contrast on indigo background -->
  <Style Selector="controls|StrataChatMessage:user SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.ChatUserBubbleSelection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.ChatUserBubbleText}" />
  </Style>

  <Style Selector="TextBox.message-edit-embed /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.message-edit-embed:focus /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="TextBox.message-edit-embed:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>

  <!-- Message actions stay flat until hovered: the button's resting shadow would outline each transparent
       action as a faint box on light surfaces. The reply target keeps Reply lit while the composer quotes it.
       Button surfaces live in the button's own template, which only a global style can reach. -->
  <Style Selector="controls|StrataChatMessage /template/ Button.strata-message-action /template/ Border#PART_Surface">
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="controls|StrataChatMessage:reply-source /template/ Button#PART_ReplyButton">
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDefault}" />
  </Style>
  <Style Selector="controls|StrataChatMessage:reply-source /template/ Button#PART_ReplyButton /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
  </Style>

  <!-- Floating "Reply" pill shown above a text selection inside a repliable message. An accent pill,
       so it reads as the invitation to act on the selection rather than as a passive tooltip. -->
  <Style Selector="Button.strata-selection-reply">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Full}" />
    <Setter Property="Padding" Value="10,5,12,5" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.strata-selection-reply /template/ Border#PART_Surface">
    <Setter Property="BoxShadow" Value="0 6 18 0 #33000000, 0 1 3 0 #22000000" />
  </Style>
  <Style Selector="Button.strata-selection-reply /template/ Border#PART_Aurora">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.strata-selection-reply:pointerover /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 8 22 0 #3D000000, 0 1 3 0 #22000000" />
  </Style>
  <Style Selector="Button.strata-selection-reply:pressed /template/ Border#PART_Surface">
    <Setter Property="Background" Value="{DynamicResource Brush.AccentGradientPressed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.strata-selection-reply PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
  </Style>
  <Style Selector="Button.strata-selection-reply TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>
